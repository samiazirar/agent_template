#!/usr/bin/env python3
"""Show Herdr task and invoked-skill time, token, and cost totals."""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


OPENAI_PRICES = {
    # Standard API USD per 1M tokens: short-context rates, then long-context.
    "gpt-5.6-sol": (5.00, 0.50, 6.25, 30.00, 10.00, 1.00, 12.50, 45.00),
    "gpt-5.6-terra": (2.00, 0.20, 2.50, 12.00, 4.00, 0.40, 5.00, 18.00),
    "gpt-5.6-luna": (0.20, 0.02, 0.25, 1.20, 0.40, 0.04, 0.50, 1.80),
}
CLAUDE_PRICES = {
    "claude-opus-5": (5.00, 0.50, 6.25, 10.00, 25.00),
}


def state_file() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return root / "herdr-costs" / "sessions.jsonl"


def iso_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def parse_time(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def today_start() -> datetime:
    return datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)


def codex_jsonl_paths() -> list[Path]:
    paths: list[Path] = []
    for root in (Path.home() / ".codex/sessions", Path.home() / ".codex/archived_sessions"):
        if root.is_dir():
            paths.extend(root.rglob("*.jsonl"))
    return paths


def latest_primary_rate_limit() -> dict[str, Any] | None:
    """Read account quota snapshots without turning quota percentages into cost."""
    windows: dict[tuple[int, int, str], dict[str, Any]] = {}
    latest: dict[str, Any] | None = None
    for path in codex_jsonl_paths():
        try:
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue
        with handle:
            for raw in handle:
                try:
                    item = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                payload = item.get("payload") or {}
                if item.get("type") != "event_msg" or payload.get("type") != "token_count":
                    continue
                limits = payload.get("rate_limits") or {}
                primary = limits.get("primary")
                when = parse_time(item.get("timestamp"))
                if not isinstance(primary, dict) or when is None:
                    continue
                try:
                    used = float(primary["used_percent"])
                    window_minutes = int(primary["window_minutes"])
                    resets_at = int(primary["resets_at"])
                except (KeyError, TypeError, ValueError):
                    continue
                if not 0.0 <= used <= 100.0 or window_minutes <= 0 or resets_at <= 0:
                    continue
                plan_type = str(limits.get("plan_type") or "unknown")
                snapshot = {
                    "observed_at": when,
                    "used_percent": used,
                    "window_minutes": window_minutes,
                    "resets_at": resets_at,
                    "plan_type": plan_type,
                }
                key = (window_minutes, resets_at, plan_type)
                window = windows.setdefault(
                    key,
                    {"first": snapshot, "latest": snapshot, "count": 0},
                )
                window["count"] += 1
                if when < window["first"]["observed_at"]:
                    window["first"] = snapshot
                if when > window["latest"]["observed_at"]:
                    window["latest"] = snapshot
                if latest is None or when > latest["observed_at"]:
                    latest = snapshot
    if latest is None:
        return None
    key = (latest["window_minutes"], latest["resets_at"], latest["plan_type"])
    window = windows[key]
    first = window["first"]
    latest_used = float(latest["used_percent"])
    opening_used = float(first["used_percent"])
    local_estimate = max(0.0, latest_used - opening_used)
    other_unassigned = max(0.0, latest_used - local_estimate)
    local_today = [
        snapshot
        for candidate in windows.values()
        if (
            candidate["latest"]["window_minutes"] == latest["window_minutes"]
            and candidate["latest"]["resets_at"] == latest["resets_at"]
            and candidate["latest"]["plan_type"] == latest["plan_type"]
        )
        for snapshot in (candidate["first"], candidate["latest"])
        if snapshot["observed_at"].astimezone().date() == latest["observed_at"].astimezone().date()
    ]
    today_values = sorted(
        {snapshot["observed_at"]: snapshot for snapshot in local_today}.values(),
        key=lambda snapshot: snapshot["observed_at"],
    )
    today_delta = None
    if len(today_values) >= 2:
        today_delta = max(
            0.0,
            float(today_values[-1]["used_percent"])
            - float(today_values[0]["used_percent"]),
        )
    reset_at = datetime.fromtimestamp(latest["resets_at"], timezone.utc)
    window_start = reset_at - timedelta(minutes=latest["window_minutes"])
    return {
        "available": True,
        "used_percent": round(latest_used, 3),
        "remaining_percent": round(max(0.0, 100.0 - latest_used), 3),
        "window_minutes": latest["window_minutes"],
        "window_label": "7 days" if latest["window_minutes"] == 10080 else f'{latest["window_minutes"]} minutes',
        "resets_at": reset_at.isoformat().replace("+00:00", "Z"),
        "window_start": window_start.isoformat().replace("+00:00", "Z"),
        "plan_type": latest["plan_type"],
        "observed_at": latest["observed_at"].isoformat().replace("+00:00", "Z"),
        "opening_used_percent": round(opening_used, 3),
        "local_observed_estimate_percent": round(local_estimate, 3),
        "other_unassigned_percent": round(other_unassigned, 3),
        "today_delta_percent": round(today_delta, 3) if today_delta is not None else None,
        "today_delta_supported": today_delta is not None,
        "snapshot_count": int(window["count"]),
        "attribution": "Local-observed estimate: percentage-point changes first observed during local turns. Opening account usage and anything not safely attributable remain Other / unassigned.",
        "data_quality": "Concurrent Codex use on another machine can change the account percentage between local snapshots and cannot be separated here. Quota percentages are not converted to dollars.",
    }


def herdr_pane(pane_id: str) -> dict[str, Any]:
    result = subprocess.run(
        ["herdr", "pane", "get", pane_id],
        check=True,
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)["result"]["pane"]


def append_record(record: dict[str, Any]) -> None:
    path = state_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600, exist_ok=True)
    os.chmod(path, 0o600)
    previous: dict[str, Any] = {}
    for line in reversed(path.read_text(encoding="utf-8").splitlines()):
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if item.get("session") == record.get("session"):
            previous = item
            break
    merged = {**previous, **{key: value for key, value in record.items() if value is not None}}
    if previous.get("registered_at"):
        merged["registered_at"] = previous["registered_at"]
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(merged, sort_keys=True) + "\n")


def load_records(workspace: str) -> list[dict[str, Any]]:
    path = state_file()
    if not path.exists():
        return []
    latest: dict[str, dict[str, Any]] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            item = json.loads(line)
        except json.JSONDecodeError:
            continue
        if item.get("workspace") == workspace and item.get("session"):
            latest[item["session"]] = item
    return list(latest.values())


def current_sessions(workspace: str) -> set[str]:
    try:
        result = subprocess.run(
            ["herdr", "api", "snapshot"],
            check=True,
            capture_output=True,
            text=True,
        )
        data = json.loads(result.stdout)["result"]["snapshot"]
    except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        return set()
    active = set()
    for pane in data.get("agents", []):
        if pane.get("workspace_id") != workspace:
            continue
        session = (pane.get("agent_session") or {}).get("value")
        if session:
            active.add(session)
    return active


def transcript_for(session: str, recorded_path: str | None = None) -> tuple[str, Path] | None:
    if recorded_path:
        candidate = Path(recorded_path).expanduser()
        if candidate.exists():
            kind = "claude" if ".claude" in candidate.parts else "codex"
            return kind, candidate
    codex_root = Path.home() / ".codex/sessions"
    if codex_root.exists():
        matches = list(codex_root.rglob(f"*{session}*.jsonl"))
        if matches:
            return "codex", matches[0]
    claude_root = Path.home() / ".claude/projects"
    if claude_root.exists():
        direct = list(claude_root.rglob(f"{session}.jsonl"))
        if direct:
            return "claude", direct[0]
        for candidate in claude_root.rglob("*.jsonl"):
            if session in candidate.name:
                return "claude", candidate
    return None


ROLE_NAME = re.compile(
    r"(?:Human Orchestrator|Operations Lead|Suborchestrator|Worker|"
    r"Plan Orchestrator|Researcher|Strategic Advisor|Advisor|Verifier|Watcher|"
    r"Usage Analyst|Usage Reader|Progress|Archive|Launcher)"
    r"\s*·\s*[^,:.;\n`]+"
)
CODEX_SESSION = re.compile(r"\b019[0-9a-f]{5}-[0-9a-f-]{27}\b", re.IGNORECASE)


def prompt_identity(path: Path) -> tuple[str | None, str | None]:
    """Read the human task name and recipient from the first native task."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None, None
    for raw in lines:
        try:
            item = json.loads(raw)
        except json.JSONDecodeError:
            continue
        payload = item.get("payload") or {}
        if item.get("type") != "response_item" or payload.get("role") != "user":
            continue
        text = "\n".join(
            part.get("text", "")
            for part in payload.get("content", [])
            if isinstance(part, dict) and part.get("type") == "input_text"
        )
        # Some archived prompts contain escaped line breaks inside input text.
        text = text.replace("\\n", "\n")
        name_match = re.search(r"^ROLE AND NAME:\s*(.+)$", text, re.MULTILINE)
        if name_match:
            candidate = name_match.group(1).split(",", 1)[0].strip()
            label_match = ROLE_NAME.search(candidate)
            label = label_match.group(0).strip(" .") if label_match else None
        else:
            label_match = re.search(
                rf"^(?:You are|Act as)\s+(?:the\s+)?({ROLE_NAME.pattern})",
                text,
                re.MULTILINE,
            )
            label = label_match.group(1).strip(" .") if label_match else None
        recipient_match = re.search(r"^REPORT RECIPIENTS?:\s*(.+)$", text, re.MULTILINE)
        recipient = None
        if recipient_match:
            parent_match = ROLE_NAME.search(recipient_match.group(1))
            if parent_match:
                recipient = parent_match.group(0).strip(" .")
        if label or recipient:
            return label, recipient
    return None, None


def history_identity(text: str, session: str) -> str | None:
    position = text.find(session)
    if position < 0:
        return None
    line_start = text.rfind("\n", 0, position) + 1
    line_end = text.find("\n", position)
    line = text[line_start:line_end if line_end >= 0 else len(text)]
    direct = ROLE_NAME.search(line)
    if direct:
        return direct.group(0).strip(" .")
    completed = re.search(r"Completed\s+([^:`]+)", line, re.IGNORECASE)
    if completed:
        phrase = completed.group(1).strip(" .-")
        role = "Worker"
        for word, candidate in (
            ("suborchestrator", "Suborchestrator"),
            ("watcher", "Watcher"),
            ("advisor", "Advisor"),
            ("researcher", "Researcher"),
            ("publisher", "Worker"),
            ("worker", "Worker"),
        ):
            if word in phrase.lower():
                role = candidate
                phrase = re.sub(rf"\b{word}\b", "", phrase, flags=re.IGNORECASE)
                break
        task = " ".join(part.capitalize() for part in re.split(r"[-_\s]+", phrase) if part)
        if task:
            return f"{role} · {task}"
    nearby = text[max(0, position - 320):position]
    matches = list(ROLE_NAME.finditer(nearby))
    return matches[-1].group(0).strip(" .") if matches else None


def malformed_label(label: str | None) -> bool:
    if not label:
        return True
    return (
        len(label) > 100
        or "\\n" in label
        or "\n" in label
        or label.startswith("PROJECT GOAL")
        or " pane w" in label
    )


def project_dir_for_workspace(workspace: str) -> Path | None:
    try:
        result = subprocess.run(
            ["herdr", "pane", "list", "--workspace", workspace],
            check=True,
            capture_output=True,
            text=True,
        )
        panes = json.loads(result.stdout)["result"]["panes"]
    except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        return None
    preferred = sorted(
        panes,
        key=lambda pane: 0
        if "history" in str(pane.get("label", "")).lower()
        else 1,
    )
    for pane in preferred:
        root = Path(pane.get("foreground_cwd") or pane.get("cwd") or "")
        if (root / "OLD_HISTORY.md").is_file():
            return root
    return None


def reconcile_workspace(workspace: str, project_dir: Path | None = None) -> int:
    """Register live and archived native Codex sessions without model work."""
    root = project_dir or project_dir_for_workspace(workspace)
    history_path = root / "OLD_HISTORY.md" if root else None
    history = ""
    if history_path and history_path.is_file():
        history = history_path.read_text(encoding="utf-8")
    existing = load_records(workspace)
    existing_by_session = {item["session"]: item for item in existing}
    known = {item["session"] for item in existing}
    active_sessions = current_sessions(workspace)
    discovered: list[dict[str, Any]] = []
    for record in existing:
        if record["session"] in active_sessions:
            continue
        if not str(record.get("surface") or "").startswith("codex"):
            continue
        found = transcript_for(record["session"], record.get("transcript_path"))
        if not found or found[0] != "codex":
            continue
        label, parent = prompt_identity(found[1])
        label = label or history_identity(history, record["session"])
        previous_label = record.get("label")
        replacement_label = label if malformed_label(previous_label) else previous_label
        if replacement_label and (
            replacement_label != previous_label
            or (parent and parent != record.get("parent_label"))
        ):
            discovered.append({
                **record,
                "label": replacement_label,
                "parent_label": parent,
            })
    try:
        result = subprocess.run(
            ["herdr", "pane", "list", "--workspace", workspace],
            check=True,
            capture_output=True,
            text=True,
        )
        panes = json.loads(result.stdout)["result"]["panes"]
    except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        panes = []
    human = next(
        (pane.get("label") for pane in panes
         if str(pane.get("label", "")).startswith("Human Orchestrator · ")),
        None,
    )
    operations = next(
        (pane.get("label") for pane in panes
         if str(pane.get("label", "")).startswith("Operations Lead · ")),
        None,
    )
    for pane in panes:
        session = (pane.get("agent_session") or {}).get("value")
        if not session:
            continue
        label = pane.get("label") or "Unlabelled agent"
        previous = existing_by_session.get(session)
        if previous and previous.get("label") == label:
            continue
        parent = human if label.startswith("Operations Lead · ") else None
        discovered.append({**(previous or {}),
            "workspace": workspace,
            "session": session,
            "label": label,
            "parent_label": parent,
            "surface": pane.get("agent") or "unknown",
            "registered_at": iso_now(),
        })
        known.add(session)
    for session in dict.fromkeys(CODEX_SESSION.findall(history)):
        if session in known:
            continue
        found = transcript_for(session)
        if not found or found[0] != "codex":
            continue
        label, parent = prompt_identity(found[1])
        label = label or history_identity(history, session)
        if not label:
            continue
        if not parent:
            if label.startswith("Operations Lead · "):
                parent = human
            elif label.startswith(("Suborchestrator · ", "Plan Orchestrator · ")):
                parent = operations
        discovered.append({
            "workspace": workspace,
            "session": session,
            "label": label,
            "parent_label": parent,
            "surface": "codex",
            "transcript_path": str(found[1]),
            "registered_at": iso_now(),
        })
        known.add(session)
    for record in discovered:
        append_record(record)
    return len(discovered)


def opencode_database() -> Path:
    root = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    return root / "opencode" / "opencode.db"


def openai_cost(
    model: str, usage: dict[str, int], *, input_includes_cache: bool = True
) -> float:
    prices = OPENAI_PRICES.get(model)
    if not prices:
        return 0.0
    cached = usage["cached"]
    writes = usage["cache_write"]
    uncached = (
        max(0, usage["input"] - cached - writes)
        if input_includes_cache
        else usage["input"]
    )
    total_input = uncached + cached + writes
    rates = prices[4:] if total_input > 272_000 else prices[:4]
    input_rate, cached_rate, write_rate, output_rate = rates
    return (
        uncached * input_rate
        + cached * cached_rate
        + writes * write_rate
        + usage["output"] * output_rate
    ) / 1_000_000


def claude_cost(model: str, usage: dict[str, int]) -> float:
    prices = CLAUDE_PRICES.get(model)
    if not prices:
        return 0.0
    input_rate, read_rate, write_5m_rate, write_1h_rate, output_rate = prices
    return (
        usage["input"] * input_rate
        + usage["cached"] * read_rate
        + usage["cache_write_5m"] * write_5m_rate
        + usage["cache_write_1h"] * write_1h_rate
        + usage["output"] * output_rate
    ) / 1_000_000


def empty_usage() -> dict[str, int]:
    return {
        "input": 0,
        "cached": 0,
        "cache_write": 0,
        "cache_write_5m": 0,
        "cache_write_1h": 0,
        "output": 0,
        "tokens": 0,
    }


def add_usage(target: dict[str, int], source: dict[str, int]) -> None:
    for key in target:
        target[key] += int(source.get(key, 0))


def usage_delta(end: dict[str, int], start: dict[str, int]) -> dict[str, int]:
    return {key: max(0, int(end.get(key, 0)) - int(start.get(key, 0))) for key in end}


def claude_message_usage(counts: dict[str, Any]) -> dict[str, int]:
    usage = empty_usage()
    usage["input"] = int(counts.get("input_tokens", 0))
    usage["cached"] = int(counts.get("cache_read_input_tokens", 0))
    creation = counts.get("cache_creation", {})
    write_1h = int(creation.get("ephemeral_1h_input_tokens", 0))
    write_5m = int(creation.get("ephemeral_5m_input_tokens", 0))
    untyped_write = max(
        0,
        int(counts.get("cache_creation_input_tokens", 0)) - write_1h - write_5m,
    )
    usage["cache_write_1h"] = write_1h
    usage["cache_write_5m"] = write_5m + untyped_write
    usage["output"] = int(counts.get("output_tokens", 0))
    usage["tokens"] = (
        usage["input"]
        + usage["cached"]
        + usage["cache_write_1h"]
        + usage["cache_write_5m"]
        + usage["output"]
    )
    return usage


def model_cost(model: str, usage: dict[str, int]) -> float:
    if model in OPENAI_PRICES:
        priced_usage = dict(usage)
        priced_usage["cache_write"] = (
            usage["cache_write"]
            + usage["cache_write_1h"]
            + usage["cache_write_5m"]
        )
        return openai_cost(model, priced_usage, input_includes_cache=False)
    return claude_cost(model, usage)


def read_codex(path: Path, since: datetime | None = None) -> dict[str, Any]:
    latest_tokens: dict[str, Any] = {}
    model = "unknown"
    effort = "unknown"
    first = None
    last = None
    durations: dict[str, int] = {}
    current_turn = ""
    turn_models: dict[str, str] = {}
    turn_usage: dict[str, dict[str, int]] = {}
    turn_when: dict[str, datetime] = {}
    turn_skills: dict[str, set[str]] = defaultdict(set)
    turn_skill_baselines: dict[tuple[str, str], dict[str, int]] = {}
    skill_paths: dict[str, str] = {}
    for raw in path.open(encoding="utf-8", errors="replace"):
        try:
            item = json.loads(raw)
        except json.JSONDecodeError:
            continue
        when = parse_time(item.get("timestamp"))
        if when:
            first = when if first is None or when < first else first
            last = when if last is None or when > last else last
        if item.get("type") == "turn_context":
            context = item.get("payload", {})
            model = context.get("model", model)
            effort = context.get("effort", effort)
            current_turn = str(context.get("turn_id") or current_turn)
            if current_turn:
                turn_models[current_turn] = model
        payload = item.get("payload", {})
        if item.get("type") == "response_item":
            payload_text = json.dumps(payload, ensure_ascii=False)
            for name, skill_path in re.findall(
                r"- ([a-z0-9-]+): .*?\(file: ([^)]*?/SKILL\.md)\)",
                payload_text,
            ):
                skill_paths[skill_path] = name
            if payload.get("type") in {"custom_tool_call", "function_call"}:
                for skill_path, name in skill_paths.items():
                    if skill_path in payload_text and current_turn:
                        if name not in turn_skills[current_turn]:
                            turn_skill_baselines[(current_turn, name)] = dict(
                                turn_usage.get(current_turn, empty_usage())
                            )
                        turn_skills[current_turn].add(name)
        if item.get("type") == "event_msg" and payload.get("type") == "token_count":
            info = payload.get("info", {})
            latest_tokens = info.get("total_token_usage", {})
            last_tokens = info.get("last_token_usage", {})
            if current_turn and last_tokens:
                per_turn = empty_usage()
                per_turn["input"] = int(last_tokens.get("input_tokens", 0))
                per_turn["cached"] = int(last_tokens.get("cached_input_tokens", 0))
                per_turn["cache_write"] = int(
                    last_tokens.get("cache_write_input_tokens", 0)
                )
                per_turn["output"] = int(last_tokens.get("output_tokens", 0))
                per_turn["tokens"] = per_turn["input"] + per_turn["output"]
                turn_usage[current_turn] = per_turn
                if when:
                    turn_when[current_turn] = when
        if item.get("type") == "event_msg" and payload.get("type") == "task_complete":
            if since is None or (when and when >= since):
                durations[payload.get("turn_id", str(len(durations)))] = int(
                    payload.get("duration_ms", 0)
                )
    usage = empty_usage()
    if since is None:
        usage["input"] = int(latest_tokens.get("input_tokens", 0))
        usage["cached"] = int(latest_tokens.get("cached_input_tokens", 0))
        usage["cache_write"] = int(latest_tokens.get("cache_write_input_tokens", 0))
        usage["output"] = int(latest_tokens.get("output_tokens", 0))
        usage["tokens"] = usage["input"] + usage["output"]
    else:
        for turn_id, item_usage in turn_usage.items():
            if turn_when.get(turn_id) and turn_when[turn_id] >= since:
                add_usage(usage, item_usage)
    skills: dict[str, dict[str, Any]] = {}
    cost = 0.0
    for turn_id, item_usage in turn_usage.items():
        if since is not None and not (
            turn_when.get(turn_id) and turn_when[turn_id] >= since
        ):
            continue
        cost += openai_cost(turn_models.get(turn_id, model), item_usage)
    for turn_id, names in turn_skills.items():
        if since is not None and not (
            turn_when.get(turn_id) and turn_when[turn_id] >= since
        ):
            continue
        turn_model = turn_models.get(turn_id, model)
        for name in names:
            associated = usage_delta(
                turn_usage.get(turn_id, empty_usage()),
                turn_skill_baselines.get((turn_id, name), empty_usage()),
            )
            entry = skills.setdefault(
                name, {"uses": 0, "usage": empty_usage(), "cost": 0.0}
            )
            entry["uses"] += 1
            add_usage(entry["usage"], associated)
            entry["cost"] += openai_cost(turn_model, associated)
    return {
        "model": model,
        "effort": effort,
        "usage": usage,
        "cost": cost,
        "active_seconds": sum(durations.values()) / 1000,
        "first": first,
        "last": last,
        "time_exact": True,
        "skills": skills,
    }


def read_claude(path: Path, since: datetime | None = None) -> dict[str, Any]:
    usage = empty_usage()
    model = "unknown"
    effort = "unknown"
    first = None
    last = None
    messages: dict[
        str, tuple[dict[str, Any], str, str, str | None, datetime | None]
    ] = {}
    skill_calls: set[tuple[str, str]] = set()
    for raw in path.open(encoding="utf-8", errors="replace"):
        try:
            item = json.loads(raw)
        except json.JSONDecodeError:
            continue
        when = parse_time(item.get("timestamp"))
        if when:
            first = when if first is None or when < first else first
            last = when if last is None or when > last else last
        message = item.get("message") or {}
        for block in message.get("content") or []:
            if not isinstance(block, dict) or block.get("name") != "Skill":
                continue
            skill = (block.get("input") or {}).get("skill")
            if isinstance(skill, str) and skill and (
                since is None or (when and when >= since)
            ):
                call_id = str(block.get("id") or item.get("uuid") or skill)
                skill_calls.add((skill, call_id))
        counts = message.get("usage")
        if not counts or item.get("isSidechain"):
            continue
        message_key = str(message.get("id") or item.get("requestId") or item.get("uuid"))
        previous = messages.get(message_key)
        active_skill = item.get("attributionSkill")
        if not active_skill and previous:
            active_skill = previous[3]
        messages[message_key] = (
            counts,
            str(message.get("model") or model),
            str(item.get("effort") or effort),
            active_skill,
            when,
        )
    skills: dict[str, dict[str, Any]] = {}
    for skill, _call_id in skill_calls:
        skills.setdefault(
            skill, {"uses": 0, "usage": empty_usage(), "cost": 0.0}
        )["uses"] += 1
    included_times: list[datetime] = []
    for counts, item_model, item_effort, active_skill, when in messages.values():
        if since is not None and not (when and when >= since):
            continue
        if when:
            included_times.append(when)
        model = item_model
        effort = item_effort
        message_usage = claude_message_usage(counts)
        add_usage(usage, message_usage)
        if isinstance(active_skill, str) and active_skill:
            entry = skills.setdefault(
                active_skill, {"uses": 0, "usage": empty_usage(), "cost": 0.0}
            )
            add_usage(entry["usage"], message_usage)
            entry["cost"] += model_cost(item_model, message_usage)
    if since is not None:
        first = min(included_times) if included_times else None
        last = max(included_times) if included_times else None
    elapsed = max(0.0, (last - first).total_seconds()) if first and last else 0.0
    cost = model_cost(model, usage)
    return {
        "model": model,
        "effort": effort,
        "usage": usage,
        "cost": cost,
        "active_seconds": elapsed,
        "first": first,
        "last": last,
        "time_exact": False,
        "skills": skills,
    }


def read_opencode(session: str, since: datetime | None = None) -> dict[str, Any] | None:
    database = opencode_database()
    if not database.exists():
        return None
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        session_row = connection.execute(
            "SELECT model FROM session WHERE id = ?", (session,)
        ).fetchone()
        rows = connection.execute(
            "SELECT id, time_created, data FROM message "
            "WHERE session_id = ? ORDER BY time_created, id",
            (session,),
        ).fetchall()
        part_rows = connection.execute(
            "SELECT message_id, data FROM part WHERE session_id = ?",
            (session,),
        ).fetchall()
    finally:
        connection.close()
    if not rows:
        return None

    model = "unknown"
    effort = "unknown"
    if session_row and session_row[0]:
        try:
            selected = json.loads(session_row[0])
            model = str(selected.get("id") or model)
            effort = str(selected.get("variant") or effort)
        except json.JSONDecodeError:
            pass

    usage = empty_usage()
    cost = 0.0
    active_seconds = 0.0
    first: datetime | None = None
    last: datetime | None = None
    current_turn = -1
    message_turn: dict[str, int] = {}
    turn_usage: dict[int, dict[str, int]] = defaultdict(empty_usage)
    turn_cost: dict[int, float] = defaultdict(float)
    included_messages: set[str] = set()

    for message_id, created_ms, raw_data in rows:
        try:
            data = json.loads(raw_data)
        except json.JSONDecodeError:
            continue
        role_name = data.get("role")
        if role_name == "user":
            current_turn += 1
        message_turn[str(message_id)] = current_turn
        when = datetime.fromtimestamp(created_ms / 1000, tz=timezone.utc)
        if since is not None and when < since:
            continue
        included_messages.add(str(message_id))
        first = when if first is None or when < first else first
        last = when if last is None or when > last else last
        if role_name != "assistant":
            continue
        model = str(data.get("modelID") or model)
        effort = str(data.get("variant") or effort)
        counts = data.get("tokens") or {}
        cache = counts.get("cache") or {}
        message_usage = empty_usage()
        message_usage["input"] = int(counts.get("input", 0))
        message_usage["cached"] = int(cache.get("read", 0))
        message_usage["cache_write"] = int(cache.get("write", 0))
        message_usage["output"] = int(counts.get("output", 0)) + int(
            counts.get("reasoning", 0)
        )
        message_usage["tokens"] = (
            message_usage["input"]
            + message_usage["cached"]
            + message_usage["cache_write"]
            + message_usage["output"]
        )
        add_usage(usage, message_usage)
        add_usage(turn_usage[current_turn], message_usage)
        message_cost = (
            model_cost(model, message_usage)
            if model in OPENAI_PRICES
            else float(data.get("cost") or 0.0)
        )
        cost += message_cost
        turn_cost[current_turn] += message_cost
        timing = data.get("time") or {}
        started = timing.get("created")
        completed = timing.get("completed")
        if isinstance(started, (int, float)) and isinstance(completed, (int, float)):
            active_seconds += max(0.0, (completed - started) / 1000)
            completed_when = datetime.fromtimestamp(completed / 1000, tz=timezone.utc)
            last = completed_when if last is None or completed_when > last else last

    calls: dict[tuple[int, str], int] = defaultdict(int)
    for message_id, raw_data in part_rows:
        if str(message_id) not in included_messages:
            continue
        try:
            data = json.loads(raw_data)
        except json.JSONDecodeError:
            continue
        if data.get("type") != "tool" or data.get("tool") != "skill":
            continue
        skill = (((data.get("state") or {}).get("input") or {}).get("name"))
        turn = message_turn.get(str(message_id), -1)
        if isinstance(skill, str) and skill and turn >= 0:
            calls[(turn, skill)] += 1

    skills: dict[str, dict[str, Any]] = {}
    for (turn, skill), uses in calls.items():
        entry = skills.setdefault(
            skill, {"uses": 0, "usage": empty_usage(), "cost": 0.0}
        )
        entry["uses"] += uses
        add_usage(entry["usage"], turn_usage[turn])
        entry["cost"] += turn_cost[turn]

    return {
        "model": model,
        "effort": effort,
        "usage": usage,
        "cost": cost,
        "active_seconds": active_seconds,
        "first": first,
        "last": last,
        "time_exact": True,
        "skills": skills,
    }


def session_metrics(
    record: dict[str, Any], since: datetime | None = None
) -> dict[str, Any]:
    if str(record.get("surface") or "").startswith("opencode"):
        metrics = read_opencode(record["session"], since)
        if metrics:
            return metrics
    found = transcript_for(record["session"], record.get("transcript_path"))
    if not found:
        return {
            "model": record.get("surface", "unknown"),
            "effort": "unknown",
            "usage": empty_usage(),
            "cost": 0.0,
            "active_seconds": 0.0,
            "first": parse_time(record.get("registered_at")),
            "last": parse_time(record.get("registered_at")),
            "time_exact": False,
            "skills": {},
        }
    kind, path = found
    return read_codex(path, since) if kind == "codex" else read_claude(path, since)


def fmt_tokens(value: int) -> str:
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    if value >= 1_000:
        return f"{value / 1_000:.1f}k"
    return str(value)


def fmt_duration(seconds: float, exact: bool = True) -> str:
    prefix = "" if exact else "~"
    total = int(seconds)
    hours, rem = divmod(total, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{prefix}{hours}h{minutes:02d}m"
    if minutes:
        return f"{prefix}{minutes}m{secs:02d}s"
    return f"{prefix}{secs}s"


def role(label: str) -> str:
    return label.split(" · ", 1)[0]


def normalized_parent(record: dict[str, Any], records: list[dict[str, Any]]) -> str | None:
    label = record["label"]
    workspace_records = [item for item in records if item["workspace"] == record["workspace"]]
    if label.startswith("Human Orchestrator · "):
        return None
    if label.startswith("Operations Lead · "):
        human = next((item["label"] for item in workspace_records if item["label"].startswith("Human Orchestrator · ")), None)
        return human
    if label.startswith("Operations Collaborator · ") or label.startswith("Plan Orchestrator · "):
        operations = next((item["label"] for item in workspace_records if item["label"].startswith("Operations Lead · ")), None)
        return operations
    parent = record.get("parent_label")
    if parent == label:
        return None
    if parent and not parent.startswith("Launcher · "):
        return parent
    operations = next((item["label"] for item in workspace_records if item["label"].startswith("Operations Lead · ")), None)
    return operations


CONTROL_OVERHEAD_ROLES = {
    "Human Orchestrator",
    "Operations Collaborator",
    "Plan Orchestrator",
    "Advisor",
    "Strategic Advisor",
    "Verifier",
    "Watcher",
    "Progress",
    "Archive",
    "Launcher",
    "Usage Analyst",
    "Usage Reader",
}


def usage_summary(
    records: list[dict[str, Any]],
    since: datetime | None = None,
    metrics_by_session: dict[str, dict[str, Any]] | None = None,
) -> dict[str, Any]:
    by_model: dict[str, int] = defaultdict(int)
    by_role: dict[str, int] = defaultdict(int)
    total_cost = 0.0
    total_cached = 0
    luna_worker_tokens = 0
    total_seconds = 0.0
    time_exact = True
    for record in records:
        metrics = (
            metrics_by_session[record["session"]]
            if metrics_by_session is not None
            else session_metrics(record, since)
        )
        tokens = int(metrics["usage"]["tokens"])
        model_key = f'{metrics["model"]}/{metrics["effort"]}'
        by_model[model_key] += tokens
        role_name = role(record["label"])
        by_role[role_name] += tokens
        if model_key == "gpt-5.6-luna/max" and role_name == "Worker":
            luna_worker_tokens += tokens
        total_cost += float(metrics["cost"])
        total_cached += int(metrics["usage"]["cached"])
        total_seconds += float(metrics["active_seconds"])
        if tokens or metrics["active_seconds"]:
            time_exact = time_exact and bool(metrics["time_exact"])
    total_tokens = sum(by_model.values())
    luna_max = luna_worker_tokens
    control = sum(
        tokens for name, tokens in by_role.items()
        if name in CONTROL_OVERHEAD_ROLES
    )
    return {
        "tokens": total_tokens,
        "cost": total_cost,
        "cached_tokens": total_cached,
        "active_seconds": total_seconds,
        "time_exact": time_exact,
        "luna_max_tokens": luna_max,
        "luna_max_pct": 100.0 * luna_max / total_tokens if total_tokens else 0.0,
        "control_tokens": control,
        "control_pct": 100.0 * control / total_tokens if total_tokens else 0.0,
        "by_model": dict(by_model),
    }


def collect_all_rows(since: datetime | None) -> list[dict[str, Any]] | None:
    try:
        result = subprocess.run(
            ["herdr", "workspace", "list"],
            check=True,
            capture_output=True,
            text=True,
        )
        workspaces = json.loads(result.stdout)["result"]["workspaces"]
    except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
        print("Could not read Herdr workspaces.", file=sys.stderr)
        return None
    rows = []
    for workspace in workspaces:
        workspace_id = workspace["workspace_id"]
        try:
            pane_result = subprocess.run(
                ["herdr", "pane", "list", "--workspace", workspace_id],
                check=True,
                capture_output=True,
                text=True,
            )
            panes = json.loads(pane_result.stdout)["result"]["panes"]
        except (OSError, subprocess.CalledProcessError, KeyError, json.JSONDecodeError):
            continue
        labels = [str(pane.get("label") or "") for pane in panes]
        if not (
            any(label.startswith("Human Orchestrator · ") for label in labels)
            and any(label.startswith("Operations Lead · ") for label in labels)
        ):
            continue
        reconcile_workspace(workspace_id)
        records = load_records(workspace_id)
        if not records:
            continue
        metrics_by_session = {
            record["session"]: session_metrics(record, since) for record in records
        }
        summary = usage_summary(records, since, metrics_by_session)
        agents: dict[str, dict[str, Any]] = {}
        for record in records:
            metrics = metrics_by_session[record["session"]]
            tokens = int(metrics["usage"]["tokens"])
            if not tokens:
                continue
            item = agents.setdefault(
                record["label"],
                {
                    "seconds": 0.0,
                    "time_exact": True,
                    "tokens": 0,
                    "cached": 0,
                    "cost": 0.0,
                    "models": set(),
                    "luna_tokens": 0,
                    "control_tokens": 0,
                },
            )
            item["seconds"] += float(metrics["active_seconds"])
            item["time_exact"] = item["time_exact"] and bool(metrics["time_exact"])
            item["tokens"] += tokens
            item["cached"] += int(metrics["usage"]["cached"])
            item["cost"] += float(metrics["cost"])
            item["models"].add(f'{metrics["model"]}/{metrics["effort"]}')
            model_key = f'{metrics["model"]}/{metrics["effort"]}'
            if role(record["label"]) == "Worker" and model_key == "gpt-5.6-luna/max":
                item["luna_tokens"] += tokens
            if role(record["label"]) in CONTROL_OVERHEAD_ROLES:
                item["control_tokens"] += tokens
        rows.append({
            "label": workspace.get("label") or workspace_id,
            "summary": summary,
            "agents": agents,
        })
    return rows


def report_all(since: datetime | None) -> int:
    rows = collect_all_rows(since)
    if rows is None:
        return 1
    period = since.astimezone().date().isoformat() if since else "all time"
    print(f"Cost summary · all recorded Herdr workspaces · {period}")
    print("Standard API-equivalent USD with cache and long-context rates; subscription billing is not included.")
    print()
    print(f'{"Project / agent":48} {"Model / effort":24} {"Time":9} {"Tokens":10} {"Cached":10} {"Luna":8} {"Control":8} {"Cost":10}')
    print("-" * 136)
    for row in rows:
        label = row["label"]
        summary = row["summary"]
        agents = row["agents"]
        majority = (
            "-"
            if not summary["tokens"]
            else "yes"
            if summary["luna_max_pct"] > 50.0
            else "NO"
        )
        print(
            f'{label[:48]:48} {"project total":24} '
            f'{fmt_duration(summary["active_seconds"], summary["time_exact"]):9} '
            f'{fmt_tokens(summary["tokens"]):10} '
            f'{fmt_tokens(summary["cached_tokens"]):10} '
            f'{summary["luna_max_pct"]:6.1f}% {summary["control_pct"]:6.1f}% '
            f'${summary["cost"]:9.3f} {majority}'
        )
        for agent_label, item in sorted(
            agents.items(), key=lambda pair: pair[1]["tokens"], reverse=True
        ):
            models = ",".join(sorted(item["models"]))[:24]
            print(
                f'{("  " + agent_label)[:48]:48} {models:24} '
                f'{fmt_duration(item["seconds"], item["time_exact"]):9} '
                f'{fmt_tokens(item["tokens"]):10} {fmt_tokens(item["cached"]):10} '
                f'{"":8} {"":8} ${item["cost"]:9.3f}'
            )
    if since is not None:
        print("\nAll project totals are shown; agent rows with no recorded usage today are omitted.")
    return 0


def rows_to_json(rows: list[dict[str, Any]]) -> dict[str, Any]:
    projects = []
    total_seconds = 0.0
    total_tokens = 0
    total_cached = 0
    total_cost = 0.0
    total_luna_tokens = 0
    total_control_tokens = 0
    total_agents = 0
    time_exact = True
    for row in rows:
        summary = row["summary"]
        project_tokens = int(summary["tokens"])
        agents = []
        for label, item in sorted(
            row["agents"].items(), key=lambda pair: pair[1]["tokens"], reverse=True
        ):
            agent_tokens = int(item["tokens"])
            agents.append({
                "label": label,
                "role": role(label),
                "models": sorted(item["models"]),
                "seconds": float(item["seconds"]),
                "time": fmt_duration(item["seconds"], item["time_exact"]),
                "time_exact": bool(item["time_exact"]),
                "tokens": agent_tokens,
                "cached_tokens": int(item["cached"]),
                "cost": round(float(item["cost"]), 9),
                "luna_tokens": int(item["luna_tokens"]),
                "luna_share_pct": round(
                    100.0 * int(item["luna_tokens"]) / project_tokens
                    if project_tokens else 0.0,
                    3,
                ),
                "control_tokens": int(item["control_tokens"]),
                "control_share_pct": round(
                    100.0 * int(item["control_tokens"]) / project_tokens
                    if project_tokens else 0.0,
                    3,
                ),
                "is_luna_worker": bool(item["luna_tokens"]),
                "is_control_role": bool(item["control_tokens"]),
            })
        projects.append({
            "label": row["label"],
            "time": fmt_duration(summary["active_seconds"], summary["time_exact"]),
            "seconds": float(summary["active_seconds"]),
            "time_exact": bool(summary["time_exact"]),
            "tokens": project_tokens,
            "cached_tokens": int(summary["cached_tokens"]),
            "cost": round(float(summary["cost"]), 9),
            "luna_tokens": int(summary["luna_max_tokens"]),
            "luna_share_pct": round(float(summary["luna_max_pct"]), 3),
            "control_tokens": int(summary["control_tokens"]),
            "control_share_pct": round(float(summary["control_pct"]), 3),
            "luna_majority": bool(summary["luna_max_pct"] > 50.0),
            "control_within_limit": bool(summary["control_pct"] <= 10.0),
            "agents": agents,
        })
        total_seconds += float(summary["active_seconds"])
        total_tokens += project_tokens
        total_cached += int(summary["cached_tokens"])
        total_cost += float(summary["cost"])
        total_luna_tokens += int(summary["luna_max_tokens"])
        total_control_tokens += int(summary["control_tokens"])
        total_agents += len(agents)
        time_exact = time_exact and bool(summary["time_exact"])
    return {
        "aggregate": {
            "project_count": len(projects),
            "agent_count": total_agents,
            "seconds": total_seconds,
            "time": fmt_duration(total_seconds),
            "time_exact": time_exact,
            "tokens": total_tokens,
            "cached_tokens": total_cached,
            "cost": round(total_cost, 9),
            "luna_tokens": total_luna_tokens,
            "luna_share_pct": round(100.0 * total_luna_tokens / total_tokens if total_tokens else 0.0, 3),
            "control_tokens": total_control_tokens,
            "control_share_pct": round(100.0 * total_control_tokens / total_tokens if total_tokens else 0.0, 3),
        },
        "projects": projects,
    }


def report_all_json(since: datetime | None) -> int:
    rows = collect_all_rows(since)
    if rows is None:
        return 1
    period = since.astimezone().date().isoformat() if since else "all time"
    daily = rows_to_json(rows)
    account = latest_primary_rate_limit()
    weekly = {
        "account": account,
        "local": None,
    }
    if account is not None:
        weekly_start = parse_time(account["window_start"])
        if weekly_start is not None:
            weekly_rows = collect_all_rows(weekly_start)
            if weekly_rows is not None:
                weekly["local"] = rows_to_json(weekly_rows)
        weekly["period_start"] = account["window_start"]
        weekly["period_end"] = account["resets_at"]
        weekly["period_label"] = account["window_label"]
    payload = {
        "schema": "herdr-costs.site.v1",
        "generated_at": iso_now(),
        "period": period,
        "source": {
            "command": "herdr-costs report --all --json"
            + (" --all-time" if since is None else ""),
            "pricing": "Standard API-equivalent USD with cache and long-context rates; subscription billing and non-token tool charges are not included.",
            "quota": "Codex token_count.rate_limits.primary from local current and archived JSONL; quota percentages are not converted into dollars.",
            "control": "Role-classified non-productive overhead lower bound. Task-direct Operations and suborchestrator decomposition, Luna dispatch, recovery, integration, and synchronization count as productive orchestration rather than control.",
        },
        "thresholds": {
            "luna_majority_pct": 50.0,
            "control_max_pct": 10.0,
        },
        "aggregate": daily["aggregate"],
        "projects": daily["projects"],
        "weekly": weekly,
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def report(workspace: str, since: datetime | None) -> int:
    reconcile_workspace(workspace)
    records = load_records(workspace)
    if not records:
        print("No registered sessions for this workspace yet.")
        return 0
    active = current_sessions(workspace)
    metrics_by_session = {
        record["session"]: session_metrics(record, since) for record in records
    }
    summary = usage_summary(records, since, metrics_by_session)
    grouped: dict[str, dict[str, Any]] = {}
    skill_totals: dict[tuple[str, str], dict[str, Any]] = {}
    for record in records:
        metrics = metrics_by_session[record["session"]]
        if not metrics["usage"]["tokens"] and not metrics["active_seconds"]:
            continue
        label = record["label"]
        node = grouped.setdefault(
            label,
            {
                "own_seconds": 0.0,
                "time_exact": True,
                "own_tokens": 0,
                "own_cost": 0.0,
                "models": set(),
                "active": False,
                "parent": normalized_parent(record, records),
            },
        )
        node["own_seconds"] += metrics["active_seconds"]
        node["time_exact"] = node["time_exact"] and metrics["time_exact"]
        node["own_tokens"] += metrics["usage"]["tokens"]
        node["own_cost"] += metrics["cost"]
        node["models"].add(f'{metrics["model"]}/{metrics["effort"]}')
        node["active"] = node["active"] or record["session"] in active
        surface = str(record.get("surface") or "unknown")
        harness = (
            "OpenCode"
            if surface.startswith("opencode")
            else "Claudex"
            if surface.startswith("claudex")
            else "Claude"
            if surface == "claude"
            else "Codex"
        )
        for skill, skill_metrics in metrics.get("skills", {}).items():
            skill_node = skill_totals.setdefault(
                (skill, harness), {"uses": 0, "tokens": 0, "cost": 0.0}
            )
            skill_node["uses"] += int(skill_metrics["uses"])
            skill_node["tokens"] += int(skill_metrics["usage"]["tokens"])
            skill_node["cost"] += float(skill_metrics["cost"])

    children: dict[str, list[str]] = defaultdict(list)
    for label, node in grouped.items():
        if node["parent"] in grouped and node["parent"] != label:
            children[node["parent"]].append(label)

    def totals(label: str, seen: set[str] | None = None) -> tuple[float, int, float, bool]:
        seen = set() if seen is None else seen
        if label in seen:
            return 0.0, 0, 0.0, True
        seen.add(label)
        node = grouped[label]
        seconds = node["own_seconds"]
        tokens = node["own_tokens"]
        cost = node["own_cost"]
        exact = node["time_exact"]
        for child in children.get(label, []):
            child_seconds, child_tokens, child_cost, child_exact = totals(child, seen)
            seconds += child_seconds
            tokens += child_tokens
            cost += child_cost
            exact = exact and child_exact
        return seconds, tokens, cost, exact

    order: list[tuple[int, str]] = []
    def walk(label: str, depth: int) -> None:
        order.append((depth, label))
        for child in sorted(children.get(label, [])):
            walk(child, depth + 1)
    roots = [label for label, node in grouped.items() if node["parent"] not in grouped]
    for root in sorted(roots):
        walk(root, 0)

    period = since.astimezone().date().isoformat() if since else "all time"
    print(f"Cost and time · workspace {workspace} · {period}")
    print("Standard API-equivalent USD with cache and long-context rates; subscription billing and non-token tool charges are not included.")
    print(
        f'Token mix: Luna max {fmt_tokens(summary["luna_max_tokens"])} '
        f'({summary["luna_max_pct"]:.1f}%); control roles '
        f'{fmt_tokens(summary["control_tokens"])} ({summary["control_pct"]:.1f}%). '
        f'Luna majority: {"yes" if summary["luna_max_pct"] > 50.0 else "NO"}.'
    )
    print()
    print(f'{"Task":45} {"Model / effort":28} {"State":7} {"Own time":10} {"Total time":10} {"Own tok":9} {"Total tok":9} {"Own $":9} {"Total $":9}')
    print("-" * 146)
    for depth, label in order:
        node = grouped[label]
        total_seconds, total_tokens, total_cost, total_exact = totals(label)
        name = ("  " * depth + label)[:45]
        models = ",".join(sorted(node["models"]))[:28]
        state = "active" if node["active"] else "closed"
        print(
            f'{name:45} {models:28} {state:7} '
            f'{fmt_duration(node["own_seconds"], node["time_exact"]):10} '
            f'{fmt_duration(total_seconds, total_exact):10} '
            f'{fmt_tokens(node["own_tokens"]):9} {fmt_tokens(total_tokens):9} '
            f'${node["own_cost"]:8.3f} ${total_cost:8.3f}'
        )
    print()
    print("~ time is transcript span because that harness does not record exact model-active duration locally.")
    print("Fresh short task sessions keep both context cost and attribution accurate.")
    if skill_totals:
        print()
        print("Skill use")
        print(f'{"Skill":52} {"Harness":9} {"Uses":6} {"Associated tok":15} {"Associated $":12}')
        print("-" * 98)
        for (skill, harness), item in sorted(skill_totals.items()):
            print(
                f'{skill[:52]:52} {harness:9} {item["uses"]:6} '
                f'{fmt_tokens(item["tokens"]):15} ${item["cost"]:11.3f}'
            )
        print()
        print("OpenCode associates each invoked skill with that user turn. Claude/Claudex use native active-skill attribution. Codex counts the exact token delta after loading a skill through turn end.")
        print("If one Codex turn loads multiple skills, associated totals overlap and must not be added together.")
    return 0


def register(args: argparse.Namespace) -> int:
    pane = herdr_pane(args.pane)
    parent = herdr_pane(args.parent_pane)
    session = (pane.get("agent_session") or {}).get("value")
    if not session and args.wait_seconds > 0:
        subprocess.run(
            [
                "herdr", "agent", "wait", args.pane,
                "--until", "working",
                "--timeout", str(args.wait_seconds * 1000),
            ],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        pane = herdr_pane(args.pane)
        session = (pane.get("agent_session") or {}).get("value")
    if not session:
        print("launched pane has no native session", file=sys.stderr)
        return 1
    append_record(
        {
            "workspace": args.workspace,
            "session": session,
            "label": pane.get("label") or args.pane,
            "parent_label": parent.get("label"),
            "surface": args.surface,
            "registered_at": iso_now(),
        }
    )
    return 0


def register_hook() -> int:
    if os.environ.get("HERDR_ENV") != "1":
        return 0
    workspace = os.environ.get("HERDR_WORKSPACE_ID")
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not workspace or not pane_id:
        return 0
    try:
        hook = json.load(sys.stdin)
        pane = herdr_pane(pane_id)
    except (json.JSONDecodeError, OSError, subprocess.CalledProcessError, KeyError):
        return 0
    session = hook.get("session_id")
    if not isinstance(session, str) or not session:
        return 0
    surface = "claudex" if os.environ.get("CLAUDEX_ACTIVE") == "1" else "claude"
    append_record(
        {
            "workspace": workspace,
            "session": session,
            "label": pane.get("label") or "Claude Code session",
            "surface": surface,
            "transcript_path": hook.get("transcript_path"),
            "registered_at": iso_now(),
        }
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command")
    register_parser = subparsers.add_parser("register", help=argparse.SUPPRESS)
    register_parser.add_argument("--workspace", required=True)
    register_parser.add_argument("--pane", required=True)
    register_parser.add_argument("--parent-pane", required=True)
    register_parser.add_argument("--surface", required=True)
    register_parser.add_argument("--wait-seconds", type=int, default=0)
    subparsers.add_parser("register-hook", help=argparse.SUPPRESS)
    reconcile_parser = subparsers.add_parser(
        "reconcile",
        help="discover unregistered live and archived native sessions",
    )
    reconcile_parser.add_argument("--workspace", required=True)
    reconcile_parser.add_argument("--project-dir", type=Path)
    report_parser = subparsers.add_parser("report")
    report_parser.add_argument("--workspace")
    report_parser.add_argument(
        "--all",
        action="store_true",
        help="show a compact cost and token-mix table for all workspaces",
    )
    report_parser.add_argument(
        "--all-time",
        action="store_true",
        help="include lifetime recorded usage instead of today only",
    )
    report_parser.add_argument(
        "--json",
        action="store_true",
        help="emit structured data for a site or other private consumer",
    )
    args = parser.parse_args()
    if args.command == "register":
        return register(args)
    if args.command == "register-hook":
        return register_hook()
    if args.command == "reconcile":
        count = reconcile_workspace(args.workspace, args.project_dir)
        print(f"Registered {count} previously missing sessions.")
        return 0
    since = None if getattr(args, "all_time", False) else today_start()
    if args.command == "report" and args.all:
        if args.json:
            return report_all_json(since)
        return report_all(since)
    workspace = getattr(args, "workspace", None) or os.environ.get("HERDR_WORKSPACE_ID")
    if not workspace:
        print("Use --workspace or run inside Herdr.", file=sys.stderr)
        return 2
    return report(workspace, since)


if __name__ == "__main__":
    raise SystemExit(main())
