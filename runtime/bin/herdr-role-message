#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: herdr-role-message <human|operations|collaborator> MESSAGE' \
    '       herdr-role-message named "Role · Human Name" MESSAGE' >&2
  exit 2
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
fi

[[ $# -ge 2 ]] || usage
[[ "${HERDR_ENV:-}" == "1" ]] || {
  printf 'herdr-role-message must run inside Herdr\n' >&2
  exit 1
}
[[ -n "${HERDR_WORKSPACE_ID:-}" ]] || {
  printf 'current Herdr workspace is unavailable\n' >&2
  exit 1
}

mode="prefix"
case "$1" in
  human) target="Human Orchestrator"; shift ;;
  operations) target="Operations Lead"; shift ;;
  collaborator) target="Operations Collaborator"; shift ;;
  named)
    [[ $# -ge 3 ]] || usage
    mode="exact"
    target="$2"
    shift 2
    ;;
  *) usage ;;
esac
message="$*"
[[ -n "$message" ]] || usage

case "$target" in
  "Operations Lead")
    message="Role reminder: dispatch technical work to a Sol-medium suborchestrator or Luna worker; do not inspect, debug, implement, run experiments, or SSH. If the goal is incomplete and no productive child is active, dispatch the next package before ending. Message: $message"
    ;;
  "Human Orchestrator")
    message="Role reminder: handle only Human conversation and plan meaning; route technical action to Operations and do not manage execution. Message: $message"
    ;;
  "Suborchestrator"\ ·\ *)
    message="Role reminder: use this child result only to close it and choose or dispatch the next Luna package; do not inspect, debug, implement, run experiments, or SSH. Message: $message"
    ;;
esac

pane_id="$(
  herdr pane list --workspace "$HERDR_WORKSPACE_ID" |
    python3 -c '
import json
import sys

mode, target = sys.argv[1:3]
panes = json.load(sys.stdin)["result"]["panes"]
matches = [
    pane["pane_id"]
    for pane in panes
    if (
        pane.get("label", "") == target
        if mode == "exact"
        else pane.get("label", "").startswith(target + " · ")
    )
    and (pane.get("agent") or pane.get("agent_session"))
]
if len(matches) != 1:
    print(
        f"expected exactly one live {target}, found {len(matches)}",
        file=sys.stderr,
    )
    raise SystemExit(1)
print(matches[0])
' "$mode" "$target"
)"

# Herdr 0.7.5 submits agent prompts atomically and refuses stale/non-agent
# targets instead of silently typing into whatever now owns the pane.
herdr agent prompt "$pane_id" "$message" >/dev/null
