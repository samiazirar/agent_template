#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: herdr-role-message <human|operations|collaborator> MESSAGE' \
    '       herdr-role-message named "Role · Human Name" MESSAGE' >&2
  exit 2
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
fi

[[ $# -ge 2 ]] || usage
[[ "${HERDR_ENV:-}" == "1" ]] || {
  printf 'herdr-role-message must run inside Herdr\n' >&2
  exit 1
}
[[ -n "${HERDR_WORKSPACE_ID:-}" ]] || {
  printf 'current Herdr workspace is unavailable\n' >&2
  exit 1
}

mode="prefix"
case "$1" in
  human) target="Human Orchestrator"; shift ;;
  operations) target="Operations Lead"; shift ;;
  collaborator) target="Operations Collaborator"; shift ;;
  named)
    [[ $# -ge 3 ]] || usage
    mode="exact"
    target="$2"
    shift 2
    ;;
  *) usage ;;
esac
message="$*"
[[ -n "$message" ]] || usage

case "$target" in
  "Operations Lead")
    message="Role reminder: dispatch technical work to a Sol-medium suborchestrator or Luna worker; do not inspect, debug, implement, run experiments, or SSH. Keep child roles visible in this project workspace: create filesystem worktrees with Git, never with 'herdr worktree create'. If the goal is incomplete and no productive child is active, dispatch the next package before ending. A continuing external job needs a terminal wake owner before you end the turn. Message: $message"
    ;;
  "Human Orchestrator")
    message="Role reminder: handle only Human conversation and plan meaning; route technical action to Operations and do not manage execution. Message: $message"
    ;;
  "Suborchestrator"\ ·\ *)
    message="Role reminder: use this child result only to close it and choose or dispatch the next Luna package; do not inspect, debug, implement, run experiments, or SSH. Keep Luna visible in this project workspace: create its filesystem worktree with Git, never with 'herdr worktree create'. Message: $message"
    ;;
esac

pane_id="$(python3 - "$mode" "$target" "$HERDR_WORKSPACE_ID" "$PWD" <<'PY'
import json
from pathlib import Path
import subprocess
import sys

mode, target, workspace_id, sender_cwd = sys.argv[1:5]


def run_json(*args):
    result = subprocess.run(
        ["herdr", *args], check=True, capture_output=True, text=True
    )
    return json.loads(result.stdout)["result"]


def target_panes(panes):
    return [
        pane
        for pane in panes
        if (
            pane.get("label", "") == target
            if mode == "exact"
            else pane.get("label", "").startswith(target + " · ")
        )
        and (pane.get("agent") or pane.get("agent_session"))
    ]


matches = target_panes(run_json("pane", "list", "--workspace", workspace_id)["panes"])

# A resumed chat can retain its pre-move HERDR_WORKSPACE_ID. Only when the
# normal lookup fails, recover the project by cwd or the shared Git directory.
if len(matches) != 1:
    sender_path = Path(sender_cwd).resolve()

    def git_root(path):
        result = subprocess.run(
            ["git", "-C", str(path), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True,
            text=True,
        )
        return Path(result.stdout.strip()).resolve() if result.returncode == 0 else None

    sender_git = git_root(sender_path)
    recovered = []
    for workspace in run_json("workspace", "list")["workspaces"]:
        panes = run_json("pane", "list", "--workspace", workspace["workspace_id"])["panes"]
        for pane in target_panes(panes):
            candidate = Path(pane.get("foreground_cwd") or pane.get("cwd") or "/").resolve()
            if candidate == sender_path or (sender_git is not None and git_root(candidate) == sender_git):
                recovered.append(pane)
    matches = recovered

if len(matches) != 1:
    print(f"expected exactly one live {target}, found {len(matches)}", file=sys.stderr)
    raise SystemExit(1)
print(matches[0]["pane_id"])
PY
)"

# Herdr 0.7.5 submits agent prompts atomically and refuses stale/non-agent
# targets instead of silently typing into whatever now owns the pane.
sent=0
for delay in 0 1 2; do
  if (( delay > 0 )); then
    sleep "$delay"
  fi
  if herdr agent prompt "$pane_id" "$message" >/dev/null 2>&1; then
    sent=1
    break
  fi
done
if [[ "$sent" != "1" ]]; then
  herdr notification show "Herdr message delivery failed" \
    --body "Could not wake ${target}; the armed emergency wake remains active." \
    --position top-right --sound request >/dev/null 2>&1 || true
  printf 'Could not deliver message to %s after bounded retries.\n' "$target" >&2
  exit 1
fi
if [[ "${HERDR_WAKE_NO_DISARM:-}" != "1" ]] && command -v herdr-emergency-wake >/dev/null 2>&1; then
  herdr-emergency-wake disarm "$HERDR_PANE_ID" >/dev/null 2>&1 || true
fi
