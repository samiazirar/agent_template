#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: herdr-emergency-wake arm operations WORKER_PANE SECONDS MESSAGE' \
    '       herdr-emergency-wake arm named "Role · Human Name" WORKER_PANE SECONDS MESSAGE' \
    '       herdr-emergency-wake disarm WORKER_PANE' >&2
  exit 2
}

[[ "${HERDR_ENV:-}" == "1" ]] || {
  printf 'herdr-emergency-wake must run inside Herdr\n' >&2
  exit 1
}
[[ -n "${HERDR_WORKSPACE_ID:-}" ]] || {
  printf 'current Herdr workspace is unavailable\n' >&2
  exit 1
}

state_base() {
  local pane_id="$1"
  printf '%s/herdr/emergency-wake/%s/%s' \
    "${XDG_STATE_HOME:-${HOME}/.local/state}" "$HERDR_WORKSPACE_ID" "$pane_id"
}

# A pane's visible text carries a spinner glyph, an elapsed-seconds counter, and
# a token tally that all change every second while the agent is doing nothing.
# Hashing the raw buffer therefore calls a hung worker "alive" forever. Keeping
# only letters and spaces drops every one of those animated fields, so the hash
# changes when real work appears -- a tool name, a path, a sentence -- and holds
# still when the agent is merely ticking.
progress_hash() {
  herdr pane read "$1" --source detection --lines 60 2>/dev/null \
    | LC_ALL=C tr -cd 'A-Za-z \n' | tr -s ' \n' ' ' | md5sum | cut -d' ' -f1
}

wake() {
  local mode="$1" owner="$2" pane_id="$3" recovery="$4" reason="$5"
  local base
  base="$(state_base "$pane_id")"

  local pane_json label="assigned role"
  if pane_json="$(herdr pane get "$pane_id" 2>/dev/null)"; then
    label="$(python3 -c '
import json
import sys

pane = json.load(sys.stdin)["result"]["pane"]
print(pane.get("label") or "assigned role")
' <<<"$pane_json")"
  fi

  local summary="${label} ${reason}"
  herdr notification show "Herdr task needs attention" \
    --body "${summary}. ${recovery}" --position top-right --sound request \
    >/dev/null 2>&1 || true
  if [[ "$mode" == "operations" ]]; then
    HERDR_WAKE_NO_DISARM=1 herdr-role-message operations \
      "Emergency wake: ${summary}. ${recovery} Do not wait or poll inside this turn."
  else
    HERDR_WAKE_NO_DISARM=1 herdr-role-message named "$owner" \
      "Emergency wake: ${summary}. ${recovery} Do not wait or poll inside this turn."
  fi
  rm -f "${base}.armed"
  : >"${base}.fired"
  exit 0
}

# SECONDS is a maximum-silence window, not a deadline. A worker that keeps
# producing output is left alone however long it takes; one that stops
# producing, blocks on input nobody will send, dies, or drops back to its
# prompt without reporting wakes the parent as soon as that is visible. Those
# are the cases where waiting silently costs the most: nothing else in the
# system notices them.
fire() {
  local workspace_id="$1"
  local mode="$2"
  local owner="$3"
  local pane_id="$4"
  local seconds="$5"
  local recovery="$6"

  export HERDR_WORKSPACE_ID="$workspace_id"
  local base
  base="$(state_base "$pane_id")"

  local poll=$(( seconds / 10 ))
  (( poll < 10 )) && poll=10
  (( poll > 60 )) && poll=60

  # A worker that finishes normally reports with herdr-role-message, which
  # disarms this watch. Allow one grace window for that message to land before
  # treating a returned-to-prompt pane as a silent failure.
  local grace=$(( poll * 3 ))

  local last_hash="" silent=0 finished=0 worked=0 status
  while :; do
    sleep "$poll"
    [[ -f "${base}.armed" ]] || exit 0

    local pane_json
    if ! pane_json="$(herdr pane get "$pane_id" 2>/dev/null)"; then
      wake "$mode" "$owner" "$pane_id" "$recovery" \
        "closed before its completion message was confirmed"
    fi
    status="$(python3 -c '
import json
import sys

print(json.load(sys.stdin)["result"]["pane"].get("agent_status") or "unknown")
' <<<"$pane_json")"

    case "$status" in
      blocked)
        wake "$mode" "$owner" "$pane_id" "$recovery" \
          "is blocked waiting for an answer that nobody is going to send"
        ;;
      idle|done)
        finished=$(( finished + poll ))
        if (( finished >= grace )); then
          # Never having worked is a different failure from having worked and
          # gone quiet: the prompt never took, so the worker has no task at all.
          if (( worked == 0 )); then
            wake "$mode" "$owner" "$pane_id" "$recovery" \
              "never started working, so its prompt was never accepted; re-send the task"
          fi
          wake "$mode" "$owner" "$pane_id" "$recovery" \
            "returned to its prompt without reporting a result, so it finished or failed unseen"
        fi
        ;;
      *)
        finished=0
        if [[ "$status" == working ]]; then worked=1; fi
        local now
        now="$(progress_hash "$pane_id")"
        if [[ "$now" != "$last_hash" ]]; then
          last_hash="$now"
          silent=0
        else
          silent=$(( silent + poll ))
          if (( silent >= seconds )); then
            wake "$mode" "$owner" "$pane_id" "$recovery" \
              "has produced no visible progress for ${silent}s while still reporting ${status}"
          fi
        fi
        ;;
    esac
  done
}

if [[ "${1:-}" == "_fire" ]]; then
  [[ $# -eq 7 ]] || usage
  fire "$2" "$3" "$4" "$5" "$6" "$7"
  exit 0
fi

if [[ "${1:-}" == "disarm" ]]; then
  [[ $# -eq 2 ]] || usage
  base="$(state_base "$2")"
  mkdir -p "$(dirname "$base")"
  rm -f "${base}.armed"
  : >"${base}.delivered"
  exit 0
fi

[[ "${1:-}" == "arm" ]] || usage
shift

mode="${1:-}"
case "$mode" in
  operations)
    [[ $# -ge 4 ]] || usage
    owner="Operations Lead"
    shift
    ;;
  named)
    [[ $# -ge 5 ]] || usage
    owner="$2"
    shift 2
    ;;
  *) usage ;;
esac

pane_id="${1:-}"
seconds="${2:-}"
shift 2
recovery="$*"

[[ "$seconds" =~ ^[1-9][0-9]*$ ]] || {
  printf 'SECONDS must be a positive integer\n' >&2
  exit 2
}
[[ -n "$pane_id" && -n "$recovery" ]] || usage

base="$(state_base "$pane_id")"
mkdir -p "$(dirname "$base")"
if [[ -f "${base}.delivered" ]]; then
  printf 'Completion message was already delivered; no emergency wake needed.\n'
  exit 0
fi
: >"${base}.armed"

nohup "$0" _fire "$HERDR_WORKSPACE_ID" "$mode" "$owner" "$pane_id" "$seconds" "$recovery" \
  </dev/null >/dev/null 2>&1 &
printf 'Emergency wake armed for %ss; a confirmed child message disarms it.\n' "$seconds"
