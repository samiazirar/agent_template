#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'usage: herdr-emergency-wake arm operations WORKER_PANE SECONDS MESSAGE' \
    '       herdr-emergency-wake arm named "Role · Human Name" WORKER_PANE SECONDS MESSAGE' \
    '       herdr-emergency-wake disarm WORKER_PANE' >&2
  exit 2
}

[[ "${HERDR_ENV:-}" == "1" ]] || {
  printf 'herdr-emergency-wake must run inside Herdr\n' >&2
  exit 1
}
[[ -n "${HERDR_WORKSPACE_ID:-}" ]] || {
  printf 'current Herdr workspace is unavailable\n' >&2
  exit 1
}

state_base() {
  local pane_id="$1"
  printf '%s/herdr/emergency-wake/%s/%s' \
    "${XDG_STATE_HOME:-${HOME}/.local/state}" "$HERDR_WORKSPACE_ID" "$pane_id"
}

fire() {
  local workspace_id="$1"
  local mode="$2"
  local owner="$3"
  local pane_id="$4"
  local seconds="$5"
  local recovery="$6"

  sleep "$seconds"

  export HERDR_WORKSPACE_ID="$workspace_id"
  local base
  base="$(state_base "$pane_id")"
  [[ -f "${base}.armed" ]] || exit 0

  local pane_json
  local summary
  if pane_json="$(herdr pane get "$pane_id" 2>/dev/null)"; then
    summary="$(python3 -c '
import json
import sys

pane = json.load(sys.stdin)["result"]["pane"]
label = pane.get("label") or "assigned role"
status = pane.get("agent_status") or "unknown"
print(f"{label} is still {status}")
' <<<"$pane_json"
    )"
  else
    summary="assigned role pane closed before its completion message was confirmed"
  fi

  local message="Emergency wake after ${seconds}s: ${summary}. ${recovery} Do not wait or poll inside this turn."
  herdr notification show "Herdr task needs attention" \
    --body "${summary}. ${recovery}" --position top-right --sound request \
    >/dev/null 2>&1 || true
  if [[ "$mode" == "operations" ]]; then
    HERDR_WAKE_NO_DISARM=1 herdr-role-message operations "$message"
  else
    HERDR_WAKE_NO_DISARM=1 herdr-role-message named "$owner" "$message"
  fi
  rm -f "${base}.armed"
  : >"${base}.fired"
}

if [[ "${1:-}" == "_fire" ]]; then
  [[ $# -eq 7 ]] || usage
  fire "$2" "$3" "$4" "$5" "$6" "$7"
  exit 0
fi

if [[ "${1:-}" == "disarm" ]]; then
  [[ $# -eq 2 ]] || usage
  base="$(state_base "$2")"
  mkdir -p "$(dirname "$base")"
  rm -f "${base}.armed"
  : >"${base}.delivered"
  exit 0
fi

[[ "${1:-}" == "arm" ]] || usage
shift

mode="${1:-}"
case "$mode" in
  operations)
    [[ $# -ge 4 ]] || usage
    owner="Operations Lead"
    shift
    ;;
  named)
    [[ $# -ge 5 ]] || usage
    owner="$2"
    shift 2
    ;;
  *) usage ;;
esac

pane_id="${1:-}"
seconds="${2:-}"
shift 2
recovery="$*"

[[ "$seconds" =~ ^[1-9][0-9]*$ ]] || {
  printf 'SECONDS must be a positive integer\n' >&2
  exit 2
}
[[ -n "$pane_id" && -n "$recovery" ]] || usage

base="$(state_base "$pane_id")"
mkdir -p "$(dirname "$base")"
if [[ -f "${base}.delivered" ]]; then
  printf 'Completion message was already delivered; no emergency wake needed.\n'
  exit 0
fi
: >"${base}.armed"

nohup "$0" _fire "$HERDR_WORKSPACE_ID" "$mode" "$owner" "$pane_id" "$seconds" "$recovery" \
  </dev/null >/dev/null 2>&1 &
printf 'Emergency wake armed for %ss; a confirmed child message disarms it.\n' "$seconds"
