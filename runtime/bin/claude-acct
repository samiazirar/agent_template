#!/usr/bin/env bash
# claude-acct - run Claude Code under one of several accounts on this machine,
# and keep the eight accounts legible as one budget.
#
# Each extra account is a directory that CLAUDE_CONFIG_DIR points at. Chat
# history, skills, agents, commands, hooks and plugins are shared through
# directory symlinks (safe: an atomic rename never targets a directory). The
# login and per-account state stay separate, which is the whole point.
# settings.json is never copied or symlinked; the launcher passes
# --settings ~/.claude/settings.json so there is one live canonical file.
#
# One account is special. Claude's default layout keeps its config file at
# ~/.claude.json, ABOVE ~/.claude/, while a CLAUDE_CONFIG_DIR profile keeps it
# inside. So the pre-existing account cannot be addressed by CLAUDE_CONFIG_DIR.
# It is used by simply not setting that variable, and it is listed like any
# other account. is_primary()/cfg_json() are the only places that care.
#
# Bash owns the files: profiles, logins, slices, launching. One embedded Python
# module (py() below) owns everything that reads and computes: identity, usage
# history, burn rates, the forecast and the pick score. status, forecast and
# pick are three renderings of that one computation, so the terminal, the
# Capacity card and the phone cannot drift apart.

set -euo pipefail

ROOT="${CLAUDE_ACCT_ROOT:-$HOME/.claude-accounts}"
CANON="$HOME/.claude"
SHARED_PROJECTS="$CANON/projects"
CANON_SETTINGS="$CANON/settings.json"
PRIMARY_CFG="$HOME/.claude.json"
THRESHOLD="${CLAUDE_ACCT_THRESHOLD:-80}"
USAGE_TTL="${CLAUDE_ACCT_USAGE_TTL:-300}"
SLICE_DIR="$HOME/.config/systemd/user"
POOL_MEMMAX="${CLAUDE_ACCT_POOL_MEMMAX:-40G}"
POOL_CPUQUOTA="${CLAUDE_ACCT_POOL_CPUQUOTA:-2400%}"
LINK_DIRS=(skills agents commands hooks plugins local-plugins skill-packages transcripts tasks)
STAGING="$ROOT/.staging"
HISTORY="$ROOT/.usage-history.tsv"
REFRESH_TIMER=claude-acct-refresh.timer

die()  { printf 'claude-acct: %s\n' "$*" >&2; exit 1; }
warn() { printf 'claude-acct: %s\n' "$*" >&2; }

is_primary() { [ "$(readlink -f "$1")" = "$(readlink -f "$CANON")" ]; }
cfg_json()   { if is_primary "$1"; then printf '%s' "$PRIMARY_CFG"; else printf '%s/.claude.json' "$(readlink -f "$1")"; fi; }
creds_json() { printf '%s/.credentials.json' "$(readlink -f "$1")"; }
usage_cache() { printf '%s/.claude-acct-usage.json' "$(readlink -f "$1")"; }

# systemd reads "-" in a unit name as hierarchy, so claude-a-b.slice would nest
# inside claude-a.slice and share its limits. Underscores do not nest.
slice_unit() { printf 'claude-%s.slice' "$(printf '%s' "$1" | tr '-' '_')"; }

# ~/.local/bin/claude is a wrapper that calls `claude-acct run`; exec'ing it
# from cmd_run would recurse forever, so resolve the real binary here. Always
# the newest installed version: `claude update` only downloads into versions/,
# so a session that says "restart to update" gets the update by restarting.
# (A fixed pin used to live in ~/.claude-accounts/claude-binary; it kept every
# restart on the old version until 2026-09-04.)
real_claude_binary() {
  local bin
  bin="$(ls -1d "$HOME"/.local/share/claude/versions/* 2>/dev/null | sort -V | tail -1)"
  [ -n "$bin" ] || die "no claude binary: $HOME/.local/share/claude/versions is empty"
  [ -x "$bin" ] || die "claude binary is not executable: $bin"
  printf '%s' "$bin"
}

# ===========================================================================
# The one computation. Every number this tool prints comes out of here.
# ===========================================================================
py() {
  CA_ROOT="$ROOT" CA_CANON="$CANON" CA_PRIMARY_CFG="$PRIMARY_CFG" \
  CA_HISTORY="$HISTORY" CA_THRESHOLD="$THRESHOLD" \
  python3 - "$@" <<'PY'
"""claude-acct's reader and forecaster.

Modes, all called from the bash half:

  info DIR                one profile as a TSV line (identity + percentages)
  token DIR               the OAuth access token, for the usage fetch
  uuid CFG                accountUuid/organizationUuid out of a config file
  orgname CFG             organizationName out of a config file
  creds-ok FILE           exit 0 if the file holds a usable login
  whose-token             stdin is an /api/oauth/profile reply -> "email<TAB>uuid"
  seed SRC DST            carry answered questions into a new profile
  history-append NAME DIR record one successful fetch, prune to 30 days
  status                  the account table, the POOL line, the legend
  forecast [--json]       the same numbers as a table or as the data contract
  pick [--fewest-live] [--exclude NAME] NAME...   one account name

The unit. Percentages of different accounts do not add up, so anything summed
is in u: one percentage point of one week of a 1x account. A max-5x week is
500 u. Used = binding % x multiplier. Per-account percentages stay visible;
pool figures, burn rates and the pick score are in u.
"""
import datetime
import json
import os
import sys
import time

ROOT = os.environ["CA_ROOT"]
CANON = os.environ["CA_CANON"]
PRIMARY_CFG = os.environ["CA_PRIMARY_CFG"]
HISTORY = os.environ["CA_HISTORY"]
THRESHOLD = float(os.environ.get("CA_THRESHOLD") or 80)
HOME = os.path.expanduser("~")
UTC = datetime.timezone.utc

# A pane launched this recently has not shown up in the usage figures yet, so
# pick charges it a per-session burn by hand. That is the anti-stacking rule.
RECENT_LAUNCH = float(os.environ.get("CLAUDE_ACCT_RECENT_LAUNCH") or 600)
# What one pane is assumed to burn, in percentage points per hour, until the
# history knows better. 0.4 pct/h is 2 u/h on a max-5x seat.
SESSION_BURN = float(os.environ.get("CLAUDE_ACCT_SESSION_BURN") or 0.4)
HISTORY_DAYS = 30
SERIES_DAYS = 7
SERIES_STEP = 1800           # the contract's 30-minute resolution
NO_WINDOW_HOURS = 7 * 24     # an account with no open week is a 7-day reserve
MIN_DAYS = 1.0 / 24.0        # keep "per day" finite in the last hour of a week

INFO_FIELDS = ["status", "email", "display", "org", "tier", "worst", "session",
               "weekly", "reset", "seen", "fable", "binding", "bindingPct",
               "multiplier"]


# ------------------------------------------------------------------- paths ---
def is_primary(d):
    return os.path.realpath(d) == os.path.realpath(CANON)


def cfg_json(d):
    return PRIMARY_CFG if is_primary(d) else os.path.join(os.path.realpath(d), ".claude.json")


def creds_json(d):
    return os.path.join(os.path.realpath(d), ".credentials.json")


def usage_cache(d):
    return os.path.join(os.path.realpath(d), ".claude-acct-usage.json")


def load(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def accounts_registered():
    """Registered account names, in the order the directory lists them."""
    try:
        names = sorted(n for n in os.listdir(ROOT) if not n.startswith("."))
    except OSError:
        return []
    return [n for n in names if os.path.isdir(os.path.join(ROOT, n))]


def tier_of(acc):
    """A team seat carries userRateLimitTier; a personal Max plan carries only
    the organization's tier, so fall back to that."""
    return acc.get("userRateLimitTier") or acc.get("organizationRateLimitTier") or ""


def multiplier_of(tier_raw):
    return {"default_claude_max_20x": 20, "default_claude_max_5x": 5}.get(tier_raw or "", 1)


# ------------------------------------------------------------------ limits ---
def parse_iso(s):
    if not s:
        return None
    try:
        t = datetime.datetime.fromisoformat(s)
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=UTC)


def iso_z(dt):
    return dt.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ") if dt else None


def windows(usage, now):
    """session / weekly / fable, each as {"pct", "reset": datetime|None}.

    A limit whose reset has passed has already emptied, so it reads as zero.
    The limits array is authoritative because it carries the Fable scope; the
    bare buckets are the fallback for a config-cached snapshot.
    """
    out = {k: {"pct": 0, "reset": None} for k in ("session", "weekly", "fable")}
    seen = set()
    for lim in (usage.get("limits") or []):
        kind = lim.get("kind")
        if kind == "session":
            key = "session"
        elif kind == "weekly_all":
            key = "weekly"
        elif kind == "weekly_scoped":
            model = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or ""
            key = "fable" if model.lower() == "fable" else None
        else:
            key = None
        if not key:
            continue
        reset = parse_iso(lim.get("resets_at"))
        expired = reset is not None and reset <= now
        out[key] = {"pct": 0 if expired else (lim.get("percent") or 0),
                    "reset": None if expired else reset}
        seen.add(key)
    for key, bucket in (("session", "five_hour"), ("weekly", "seven_day")):
        if key in seen:
            continue
        b = usage.get(bucket) or {}
        reset = parse_iso(b.get("resets_at"))
        expired = reset is not None and reset <= now
        out[key] = {"pct": 0 if expired else (b.get("utilization") or 0),
                    "reset": None if expired else reset}
    return out


def worst_live(usage, now):
    """The fullest limit of any kind, which is what the threshold looks at."""
    worst = 0
    for lim in (usage.get("limits") or []):
        reset = parse_iso(lim.get("resets_at"))
        if reset is not None and reset <= now:
            continue
        worst = max(worst, lim.get("percent") or 0)
    if not (usage.get("limits") or []):
        w = windows(usage, now)
        worst = max(w["session"]["pct"], w["weekly"]["pct"])
    return worst


def read_profile(d, now):
    """One profile directory as a record. status is the same vocabulary as
    before: ok | nologin | expired | nousage | empty."""
    rec = {"dir": os.path.realpath(d), "primary": is_primary(d), "status": "empty",
           "email": "", "display": "", "org": "", "tier": "", "multiplier": 1,
           "worst": 0, "seen": 0, "err": "",
           "session": {"pct": 0, "reset": None},
           "weekly": {"pct": 0, "reset": None},
           "fable": {"pct": 0, "reset": None}}
    cfg = load(cfg_json(d))
    if cfg is None:
        return rec
    acc = cfg.get("oauthAccount") or {}
    rec.update(email=acc.get("emailAddress", ""),
               display=acc.get("displayName") or acc.get("fullName", ""),
               org=acc.get("organizationName", ""),
               tier=tier_of(acc).replace("default_claude_", "").replace("_", " "),
               multiplier=multiplier_of(tier_of(acc)))
    if not rec["email"]:
        rec["status"] = "nologin"
        return rec
    cred = load(creds_json(d)) or {}
    oauth = cred.get("claudeAiOauth") or {}
    if not oauth:
        rec["status"] = "nologin"
        return rec
    if (oauth.get("refreshTokenExpiresAt", 0) / 1000) < now.timestamp():
        rec["status"] = "expired"
        return rec

    # Prefer our own live fetch; fall back to whatever Claude last cached.
    cache = usage_cache(d)
    usage = load(cache)
    if usage is not None:
        rec["seen"] = int(os.path.getmtime(cache))
    else:
        cu = cfg.get("cachedUsageUtilization") or {}
        usage = cu.get("utilization") or None
        rec["seen"] = int(cu.get("fetchedAtMs", 0) / 1000)
    try:
        with open(cache + ".err") as fh:
            rec["err"] = fh.read().strip()
    except OSError:
        pass
    if not usage:
        rec["status"] = "nousage"
        return rec
    rec["status"] = "ok"
    rec.update(windows(usage, now))
    rec["worst"] = worst_live(usage, now)
    return rec


# ----------------------------------------------------------------- history ---
HIST_HEADER = "# epoch\tname\tbinding\tweekly\tfable\tsession\tresetEpoch\n"


def history_append(name, d):
    now = datetime.datetime.now(UTC)
    rec = read_profile(d, now)
    if rec["status"] != "ok":
        return
    binding, _, reset = binding_of(rec)
    line = "%d\t%s\t%g\t%g\t%g\t%g\t%s\n" % (
        rec["seen"] or int(now.timestamp()), name, binding, rec["weekly"]["pct"],
        rec["fable"]["pct"], rec["session"]["pct"],
        int(reset.timestamp()) if reset else "")
    if history_has(line.split("\t", 2)[0], name):
        return                       # the same fetch, recorded by another pane
    if not os.path.exists(HISTORY):
        line = HIST_HEADER + line
    # One write of one short line: eight parallel refreshes append to this file
    # and O_APPEND keeps each of them whole.
    with open(HISTORY, "a") as fh:
        fh.write(line)
    history_prune()


def history_has(epoch, name):
    """Was this exact snapshot already recorded? Two panes refreshing at the
    same moment both fetch and both append, and one row is enough."""
    needle = "%s\t%s\t" % (epoch, name)
    try:
        with open(HISTORY, "rb") as fh:
            size = fh.seek(0, os.SEEK_END)
            fh.seek(max(0, size - 65536))
            return needle in fh.read().decode("utf-8", "replace")
    except OSError:
        return False


def history_prune():
    """Keep 30 days. Cheap: only the first data line is read to decide."""
    cutoff = time.time() - HISTORY_DAYS * 86400
    try:
        with open(HISTORY) as fh:
            for line in fh:
                if line.startswith("#"):
                    continue
                first = float(line.split("\t", 1)[0])
                break
            else:
                return
    except (OSError, ValueError):
        return
    if first >= cutoff - 86400:          # a day of slack, so this rewrites rarely
        return
    tmp = HISTORY + ".tmp.%d" % os.getpid()
    try:
        with open(HISTORY) as src, open(tmp, "w") as dst:
            dst.write(HIST_HEADER)
            for line in src:
                if line.startswith("#"):
                    continue
                try:
                    if float(line.split("\t", 1)[0]) >= cutoff:
                        dst.write(line)
                except ValueError:
                    continue
        os.replace(tmp, HISTORY)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def history_read(tail_bytes=None):
    """name -> [(epoch, bindingPct, weeklyPct, fablePct)], oldest first.

    tail_bytes reads only the end of the log, which is all a burn rate needs;
    the full file is only read for the seven-day series in the contract.
    """
    out = {}
    try:
        with open(HISTORY, "rb") as fh:
            if tail_bytes:
                size = fh.seek(0, os.SEEK_END)
                if size > tail_bytes:
                    fh.seek(size - tail_bytes)
                    fh.readline()        # drop the partial line
                else:
                    fh.seek(0)
            data = fh.read().decode("utf-8", "replace")
    except OSError:
        return out
    for line in data.splitlines():
        if not line or line.startswith("#"):
            continue
        f = line.split("\t")
        if len(f) < 3:
            continue
        try:
            b = float(f[2])
            w = float(f[3]) if len(f) > 3 and f[3] else b
            fb = float(f[4]) if len(f) > 4 and f[4] else b
            out.setdefault(f[1], []).append((float(f[0]), b, w, fb))
        except ValueError:
            continue
    for pts in out.values():
        pts.sort()
    return out


def burn_rate(pts, now, hours, col=1):
    """Percentage points per hour, from the rises inside the window.

    col picks the limit: 1 binding, 2 weekly all-model, 3 weekly Fable. Only
    the rises are summed, so a weekly reset in the middle of the window reads
    as a pause rather than as negative usage.
    """
    lo = now - hours * 3600
    win = [p for p in pts if p[0] >= lo]
    if len(win) < 2:
        return 0.0
    span = (win[-1][0] - win[0][0]) / 3600.0
    if span < 0.25:
        return 0.0
    gain = sum(max(0.0, b[col] - a[col]) for a, b in zip(win, win[1:]))
    return gain / span


def series(pts, now):
    """The contract's history: 30-minute buckets, seven days, max 336 points.

    Each point is [epoch, bindingPct, weeklyPct, fablePct], so a view can draw
    the all-model week and the Fable week as separate lines."""
    lo = now - SERIES_DAYS * 86400
    buckets = {}
    for p in pts:
        if p[0] < lo:
            continue
        buckets[int(p[0] // SERIES_STEP)] = p[1:]
    keys = sorted(buckets)[-(SERIES_DAYS * 48):]
    return [[k * SERIES_STEP] + [round(v, 1) for v in buckets[k]] for k in keys]


# -------------------------------------------------------------- live panes ---
def live_map():
    """account key -> {"live", "recent"} from one /proc walk.

    The key is the basename of CLAUDE_CONFIG_DIR, or "" for a session on the
    Claude default location, which is how the primary account is addressed.
    """
    vdir = os.path.join(HOME, ".local/share/claude/versions") + "/"
    now = time.time()
    out = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            if not os.readlink("/proc/%s/exe" % pid).startswith(vdir):
                continue
        except OSError:
            continue
        key = ""
        try:
            with open("/proc/%s/environ" % pid, "rb") as fh:
                for entry in fh.read().split(b"\0"):
                    if entry.startswith(b"CLAUDE_CONFIG_DIR="):
                        key = os.path.basename(entry.split(b"=", 1)[1]
                                               .decode("utf-8", "replace").rstrip("/"))
                        break
        except OSError:
            continue
        try:
            started = os.stat("/proc/%s" % pid).st_mtime
        except OSError:
            started = now
        slot = out.setdefault(key, {"live": 0, "recent": 0})
        slot["live"] += 1
        if now - started <= RECENT_LAUNCH:
            slot["recent"] += 1
    return out


# ----------------------------------------------------------------- metrics ---
def binding_of(rec):
    """(percent, which, reset) for the binding limit: the fuller of the two
    weekly windows. Its own reset is preferred; if the binding window has no
    reset of its own, the other weekly window's reset still bounds it."""
    week, fable = rec["weekly"], rec["fable"]
    which = "fable" if fable["pct"] > week["pct"] else "weekly"
    pct = max(week["pct"], fable["pct"])
    reset = rec[which]["reset"] or week["reset"] or fable["reset"]
    return pct, which, reset


def measure(rec, live, recent, pts, now_ts):
    """Everything derived, per account. Percentages and their unit twins."""
    mult = rec["multiplier"] or 1
    used, which, reset = binding_of(rec)
    if rec["status"] != "ok":
        used, which, reset = 0, "weekly", None
    hours = (reset.timestamp() - now_ts) / 3600.0 if reset else NO_WINDOW_HOURS
    hours = max(hours, 1.0 / 60.0)
    days = max(hours / 24.0, MIN_DAYS)

    burn6 = burn_rate(pts, now_ts, 6)
    burn24 = burn_rate(pts, now_ts, 24)
    per_session = burn6 / live if (live and burn6) else 0.0

    left_pct = max(0.0, 100.0 - used)
    per_day = left_pct / days
    projected = min(100.0, used + burn24 * hours)
    slack = max(0.0, 100.0 - projected)
    lock_at = None
    if burn24 > 0 and used + burn24 * hours >= 100:
        lock_at = now_ts + (left_pct / burn24) * 3600

    # Anti-stacking: a pane launched in the last ten minutes has not reached
    # the usage figures yet, so charge it to the score. It only lowers the
    # score; it never excludes an account, because it is an assumption rather
    # than a measurement.
    charged = recent * (per_session or SESSION_BURN) * hours
    score = max(0.0, slack - charged) * mult / hours

    m = {
        "multiplier": mult,
        "binding": which, "bindingPct": round(used, 1),
        "resetsAt": iso_z(reset), "hoursToReset": round(hours, 1),
        "remainingPerDay": round(per_day, 1),
        "burn6h": round(burn6, 2), "burn24h": round(burn24, 2),
        "perSessionBurn": round(per_session, 2),
        "projectedAtReset": round(projected, 1),
        "slack": round(slack, 1),
        "lockAt": iso_z(datetime.datetime.fromtimestamp(lock_at, UTC)) if lock_at else None,
        "score": round(score, 2),
        "units": {"week": 100 * mult,
                  "used": round(used * mult, 1),
                  "left": round(left_pct * mult, 1),
                  "perDay": round(per_day * mult, 1),
                  "burn6h": round(burn6 * mult, 2),
                  "burn24h": round(burn24 * mult, 2),
                  "perSession": round(per_session * mult, 2),
                  "slack": round(slack * mult, 1)},
    }
    m["_reset_ts"] = reset.timestamp() if reset else None
    m["_lock_ts"] = lock_at
    return m


def survey(names=None, tail_bytes=None, full_history=False):
    """The whole pool, computed once: accounts (soonest reset first) + pool."""
    now = datetime.datetime.now(UTC)
    now_ts = now.timestamp()
    panes = live_map()
    hist = history_read(None if full_history else (tail_bytes or 262144))
    have_history = any(len(v) >= 2 for v in hist.values())

    accts = []
    for name in (names if names is not None else accounts_registered()):
        d = os.path.join(ROOT, name)
        if not os.path.isdir(d):
            continue
        rec = read_profile(d, now)
        key = "" if rec["primary"] else name
        slot = panes.get(key) or {"live": 0, "recent": 0}
        pts = hist.get(name, [])
        a = {"name": name, "email": rec["email"], "display": rec["display"],
             "tier": rec["tier"], "status": rec["status"],
             "live": slot["live"], "recentLaunches": slot["recent"],
             "primary": rec["primary"], "seenAt": rec["seen"], "err": rec["err"],
             "worst": rec["worst"],
             "session": {"pct": rec["session"]["pct"], "resetsAt": iso_z(rec["session"]["reset"])},
             "weekly": {"pct": rec["weekly"]["pct"], "resetsAt": iso_z(rec["weekly"]["reset"]),
                        "burn24h": round(burn_rate(pts, now_ts, 24, 2), 2)},
             "fable": {"pct": rec["fable"]["pct"], "resetsAt": iso_z(rec["fable"]["reset"]),
                       "burn24h": round(burn_rate(pts, now_ts, 24, 3), 2)},
             "history": series(pts, now_ts) if full_history else []}
        a.update(measure(rec, slot["live"], slot["recent"], pts, now_ts))
        accts.append(a)

    # Soonest reset first, in every view; no open window sorts last.
    accts.sort(key=lambda a: (a["_reset_ts"] is None, a["_reset_ts"] or 0, a["name"]))

    usable = [a for a in accts if eligible(a)]
    resets = [a["_reset_ts"] for a in accts if a["_reset_ts"]]
    locks = [a["_lock_ts"] for a in accts if a["_lock_ts"]]
    counted = [a for a in accts if a["status"] in ("ok", "nousage")]
    soon = [a for a in counted if a["_reset_ts"] and a["_reset_ts"] - now_ts <= 86400]
    pool = {
        "accounts": len(counted), "usable": len(usable),
        "live": sum(a["live"] for a in accts),
        "unitsWeek": sum(a["units"]["week"] for a in counted),
        "unitsLeft": round(sum(a["units"]["left"] for a in counted), 1),
        "remainingPerDay": round(sum(a["units"]["perDay"] for a in counted), 1),
        "slack24h": round(sum(a["units"]["slack"] for a in soon), 1),
        "atRisk": sum(1 for a in counted if a["_lock_ts"]),
        "firstLockAt": iso_z(datetime.datetime.fromtimestamp(min(locks), UTC)) if locks else None,
        "nextResetAt": iso_z(datetime.datetime.fromtimestamp(min(resets), UTC)) if resets else None,
        "pick": max(usable, key=lambda a: a["score"])["name"] if usable else None,
        "_next_ts": min(resets) if resets else None,
    }
    return {"generatedAt": iso_z(now),
            "threshold": int(THRESHOLD) if THRESHOLD == int(THRESHOLD) else THRESHOLD,
            "unit": {"symbol": "u",
                     "meaning": "one percentage point of one week of a 1x account",
                     "weekPer1x": 100},
            "haveHistory": have_history, "pool": pool, "accounts": accts}


def eligible(a):
    """Pickable: logged in, under the threshold, and not projected to lock."""
    if a["status"] not in ("ok", "nousage"):
        return False
    if a["bindingPct"] >= THRESHOLD or a["worst"] >= THRESHOLD:
        return False
    return a["_lock_ts"] is None


# ------------------------------------------------------------------ render ---
def dur(seconds):
    if seconds is None:
        return "-"
    s = max(0, int(seconds))
    d, h, m = s // 86400, (s % 86400) // 3600, (s % 3600) // 60
    if d:
        return "%dd %dh" % (d, h)
    if h:
        return "%dh %dm" % (h, m)
    return "%dm" % m


def pct(v):
    return "%g%%" % round(v, 1)


def u(v, suffix=" u"):
    """Units for a table: whole u once there are more than ten of them, since
    the tenth of a percentage point behind them is noise."""
    return "%d%s" % (round(v), suffix) if abs(v) >= 10 else "%g%s" % (round(v, 1), suffix)


def seen_col(a, now_ts):
    if not a["seenAt"]:
        out = "-"
    else:
        out = "%s ago" % dur(now_ts - a["seenAt"])
    # A figure the last refresh could not replace, or one older than an hour,
    # is history rather than the current state. Say so next to it.
    if a["err"]:
        out += " stale(%s)" % a["err"]
    elif a["seenAt"] and now_ts - a["seenAt"] > 3600:
        out += " stale"
    return out


def name_col(a):
    mark = " *" if a["primary"] else ""
    if a["email"]:
        want = slug_raw(a["email"])
        # a suffix means the name was disambiguated by domain or organization
        if want and a["name"] != want and not a["name"].startswith(want + "-"):
            mark += " !"
    return a["name"] + mark


def slug_raw(email):
    local = email.split("@")[0].lower()
    out = "".join(c if c.isalnum() else "-" for c in local)
    while "--" in out:
        out = out.replace("--", "-")
    return out.strip("-")


def pool_block(s, now_ts):
    p = s["pool"]
    nxt_in = dur(p["_next_ts"] - now_ts) if p["_next_ts"] else "-"
    lines = [
        "POOL  %d accounts, %d usable, %d live  ·  %s/week, %s left  ·  %s/day"
        % (p["accounts"], p["usable"], p["live"], u(p["unitsWeek"]),
           u(p["unitsLeft"]), u(p["remainingPerDay"])),
        "      %s expiring unused in 24 h  ·  %d at risk  ·  first lock %s  ·  next reset %s  ·  next seat %s"
        % (u(p["slack24h"]), p["atRisk"], p["firstLockAt"] or "none", nxt_in,
           p["pick"] or "none"),
    ]
    return lines


DEAD = {"expired": "sign-in expired; this account is skipped until it logs in again",
        "nologin": "no login in this profile",
        "empty": "no config file, so this is not an account yet"}


def render_status(s):
    now_ts = time.time()
    fmt = "%-27s %4s %4s %5s %5s %5s %5s %9s %8s %9s %10s  %s"
    hdr = fmt % ("ACCOUNT", "TIER", "LIVE", "SESS", "WEEK", "FABLE", "BIND",
                 "LEFT/DAY", "BURN 6h", "AT RESET", "RESETS IN", "SEEN")
    out = [hdr]
    for a in s["accounts"]:
        tier = "%gx" % a["multiplier"]
        live = str(a["live"]) if a["live"] else "-"
        resets_in = dur(a["_reset_ts"] - now_ts) if a["_reset_ts"] else "-"
        if a["status"] == "ok":
            at_reset = "lock %s" % dur(a["_lock_ts"] - now_ts) if a["_lock_ts"] \
                else pct(a["projectedAtReset"])
            out.append(fmt % (name_col(a), tier, live, pct(a["session"]["pct"]),
                              pct(a["weekly"]["pct"]), pct(a["fable"]["pct"]),
                              pct(a["bindingPct"]), u(a["units"]["perDay"]),
                              u(a["units"]["burn6h"], " u/h"), at_reset,
                              resets_in, seen_col(a, now_ts)))
        elif a["status"] == "nousage":
            out.append(fmt % (name_col(a), tier, live, "?", "?", "?", "?", "?",
                              "?", "?", resets_in, seen_col(a, now_ts)))
        else:
            # No numbers to align, so say what is wrong in plain words instead
            # of a row of dashes.
            out.append("%-27s %4s %4s  %s" % (name_col(a), tier, live, DEAD[a["status"]]))
    out.append("-" * min(len(hdr), 131))
    out.extend(pool_block(s, now_ts))
    out.append("")
    out.append("1 u = 1% of one week of a 1x account, so a max-5x week is 500 u.")
    out.append("BIND is the fuller weekly window, Fable or all-model; everything derived uses it.")
    out.append("threshold %g%%  ·  an account is skipped once any live limit reaches it"
               % THRESHOLD)
    if not s["haveHistory"]:
        out.append("no usage history yet, so burn rates read 0; the refresh timer needs about an hour")
    if any(a["primary"] for a in s["accounts"]):
        out.append("* uses Claude default location (no CLAUDE_CONFIG_DIR)")
    if any(" !" in name_col(a) for a in s["accounts"]):
        out.append("! registered name no longer matches the login (run: claude-acct adopt)")
    return "\n".join(out)


def render_forecast(s):
    now_ts = time.time()
    fmt = "%-24s %4s %4s %5s %7s %7s %8s %8s %8s %9s %7s %6s %10s"
    out = [fmt % ("ACCOUNT", "TIER", "LIVE", "BIND", "LEFT", "/DAY", "BURN 6h",
                  "BURN 24h", "/SESS", "AT RESET", "SLACK", "SCORE", "RESETS IN")]
    for a in s["accounts"]:
        if a["status"] not in ("ok", "nousage"):
            out.append("%-24s %4s %4s  %s" % (a["name"], "%gx" % a["multiplier"],
                                              a["live"] or "-", DEAD[a["status"]]))
            continue
        un = a["units"]
        at_reset = "lock %s" % dur(a["_lock_ts"] - now_ts) if a["_lock_ts"] \
            else pct(a["projectedAtReset"])
        out.append(fmt % (a["name"], "%gx" % a["multiplier"], a["live"] or "-",
                          pct(a["bindingPct"]), u(un["left"]), u(un["perDay"]),
                          u(un["burn6h"], " u/h"), u(un["burn24h"], " u/h"),
                          u(un["perSession"], " u/h"), at_reset, u(un["slack"]),
                          "%.2f" % a["score"],
                          dur(a["_reset_ts"] - now_ts) if a["_reset_ts"] else "-"))
    out.append("-" * 119)
    out.extend(pool_block(s, now_ts))
    out.append("")
    out.append("score = slack in u / hours to reset, so the seat whose budget expires soonest goes first.")
    out.append("a pane launched in the last %d min is charged one /SESS burn against the score."
               % int(RECENT_LAUNCH / 60))
    if not s["haveHistory"]:
        out.append("no usage history yet: burn, AT RESET and SLACK assume nothing is burning.")
    return "\n".join(out)


CONTRACT = ["name", "email", "tier", "multiplier", "status", "live",
            "recentLaunches", "primary", "units", "session", "weekly", "fable",
            "binding", "bindingPct", "resetsAt", "hoursToReset",
            "remainingPerDay", "burn6h", "burn24h", "perSessionBurn",
            "projectedAtReset", "slack", "lockAt", "score", "seenAt", "err",
            "history"]


def contract(s):
    return {"generatedAt": s["generatedAt"], "threshold": s["threshold"],
            "unit": s["unit"], "haveHistory": s["haveHistory"],
            "pool": {k: v for k, v in s["pool"].items() if not k.startswith("_")},
            "accounts": [{k: a[k] for k in CONTRACT if k in a} for a in s["accounts"]]}


# -------------------------------------------------------------------- pick ---
def do_pick(argv):
    fewest = False
    exclude = None
    chain = []
    i = 0
    while i < len(argv):
        if argv[i] == "--fewest-live":
            fewest = True
        elif argv[i] == "--exclude":
            i += 1
            exclude = argv[i]
        else:
            chain.append(argv[i])
        i += 1
    order = {n: i for i, n in enumerate(chain)}
    known = accounts_registered()
    for n in chain:
        if n not in known:
            sys.stderr.write("claude-acct: chain names an unknown account: %s\n" % n)
    wanted = [n for n in chain if n in known and n != exclude]
    if not wanted:
        sys.stderr.write("claude-acct: no usable account in chain: %s\n" % " ".join(chain))
        return 1
    s = survey(names=wanted)
    for a in s["accounts"]:
        if a["status"] == "nousage":
            sys.stderr.write("claude-acct: %s: no usage figure cached yet, treating it as free\n" % a["name"])
        elif a["status"] not in ("ok",):
            sys.stderr.write("claude-acct: %s: %s, skipping\n" % (a["name"], a["status"]))
    usable = [a for a in s["accounts"] if eligible(a)]
    if usable:
        if fewest:
            # The old rule, kept for CLAUDE_ACCT_PICK=fewest-live: fewest live
            # sessions, chain order only breaking ties.
            best = min(usable, key=lambda a: (a["live"], order[a["name"]]))
        else:
            best = max(usable, key=lambda a: (a["score"], -order[a["name"]]))
        print(best["name"])
        return 0
    live_ones = [a for a in s["accounts"] if a["status"] in ("ok", "nousage")]
    if not live_ones:
        sys.stderr.write("claude-acct: no usable account in chain: %s\n" % " ".join(chain))
        return 1
    best = min(live_ones, key=lambda a: (a["bindingPct"], order[a["name"]]))
    sys.stderr.write("claude-acct: every account in the chain is at or above %g%% or "
                     "projected to lock; using %s (%g%%)\n"
                     % (THRESHOLD, best["name"], best["bindingPct"]))
    print(best["name"])
    return 0


# ------------------------------------------------------------- small modes ---
def mode_info(d):
    now = datetime.datetime.now(UTC)
    rec = read_profile(d, now)
    binding, which, reset = binding_of(rec)
    row = {"status": rec["status"], "email": rec["email"], "display": rec["display"],
           "org": rec["org"], "tier": rec["tier"], "worst": rec["worst"],
           "session": rec["session"]["pct"], "weekly": rec["weekly"]["pct"],
           "reset": int(reset.timestamp()) if reset else "", "seen": rec["seen"],
           "fable": rec["fable"]["pct"], "binding": which,
           "bindingPct": binding, "multiplier": rec["multiplier"]}
    if rec["status"] != "ok":
        row["reset"] = ""
    print("\t".join(str(row[k]) for k in INFO_FIELDS))


def mode_seed(src_p, dst_p):
    """Carry the questions you already answered into a new profile."""
    GLOBAL = ["hasCompletedOnboarding", "lastOnboardingVersion", "hasSeenUltraplanTerms",
              "installMethod", "autoUpdates", "autoUpdatesProtectedForNative",
              "mcpServers", "officialMarketplaceAutoInstalled",
              "officialMarketplaceAutoInstallAttempted", "respectGitignore",
              "shiftEnterKeyBindingInstalled"]
    PROJECT = ["hasTrustDialogAccepted", "hasClaudeMdExternalIncludesApproved",
               "hasClaudeMdExternalIncludesWarningShown", "allowedTools",
               "enabledMcpjsonServers", "disabledMcpjsonServers"]
    APPROVALS = {"hasTrustDialogAccepted", "hasClaudeMdExternalIncludesApproved",
                 "hasClaudeMdExternalIncludesWarningShown"}
    with open(src_p) as fh:
        src = json.load(fh)
    if os.path.exists(dst_p):
        try:
            with open(dst_p) as fh:
                dst = json.load(fh)
        except Exception as exc:
            # Overwriting an unreadable config would wipe oauthAccount and force
            # a re-login. A transient read failure must never cost a login.
            raise SystemExit("refusing to rewrite %s: it exists but could not be "
                             "parsed (%s). Nothing was changed." % (dst_p, exc))
    else:
        dst = {}
    for k in GLOBAL:
        if k in src:
            dst.setdefault(k, src[k])
    projects, n = dst.setdefault("projects", {}), 0
    for path, cfg in (src.get("projects") or {}).items():
        if not cfg.get("hasTrustDialogAccepted"):
            continue
        tgt = projects.setdefault(path, {})
        for k in PROJECT:
            if k not in cfg:
                continue
            # An approval the source already granted must win. Claude writes
            # these as false the first time it runs in an untrusted directory,
            # and setdefault would then keep the false forever.
            if k in APPROVALS and cfg[k]:
                tgt[k] = cfg[k]
            else:
                tgt.setdefault(k, cfg[k])
        n += 1
    tmp = dst_p + ".claude-acct.tmp"
    with open(tmp, "w") as fh:
        json.dump(dst, fh, indent=2)
    os.replace(tmp, dst_p)
    print("carried over %d trusted directories and your onboarding answers" % n)


def main(argv):
    mode = argv[0] if argv else "status"
    rest = argv[1:]
    if mode == "info":
        mode_info(rest[0])
    elif mode == "token":
        cred = load(creds_json(rest[0])) or {}
        tok = (cred.get("claudeAiOauth") or {}).get("accessToken")
        if not tok:
            return 1
        print(tok)
    elif mode == "uuid":
        # One login can sit in several organizations (a team seat and a personal
        # plan), each with its own limits, so identity is user + organization.
        acc = (load(rest[0]) or {}).get("oauthAccount") or {}
        org = acc.get("organizationUuid", "")
        print(acc.get("accountUuid", "") + ("/" + org if org else ""))
    elif mode == "orgname":
        acc = (load(rest[0]) or {}).get("oauthAccount") or {}
        print(acc.get("organizationName", ""))
    elif mode == "creds-ok":
        cred = load(rest[0]) or {}
        return 0 if cred.get("claudeAiOauth") else 1
    elif mode == "whose-token":
        try:
            acc = json.load(sys.stdin)["account"]
        except Exception:
            return 1
        if not acc.get("uuid"):
            return 1
        print("%s\t%s" % (acc.get("email", ""), acc["uuid"]))
    elif mode == "seed":
        mode_seed(rest[0], rest[1])
    elif mode == "history-append":
        history_append(rest[0], rest[1])
    elif mode == "status":
        print(render_status(survey()))
    elif mode == "forecast":
        s = survey(full_history=True)
        if "--json" in rest:
            print(json.dumps(contract(s), indent=2))
        else:
            print(render_forecast(s))
    elif mode == "pick":
        return do_pick(rest)
    else:
        sys.stderr.write("claude-acct: unknown internal mode %s\n" % mode)
        return 2
    return 0


sys.exit(main(sys.argv[1:]))
PY
}

acct_info() { py info "$1"; }
field() { printf '%s' "$1" | cut -f"$2"; }

# ---------------------------------------------------------------- usage API ---
refresh_usage() {  # $1 = profile dir. Quiet; failure just leaves the old value
  # and records why in "$cache.err" (the HTTP code, or "curl-failed"), so status
  # can mark the old value stale. Success removes that file and appends one
  # history point, which is where every burn rate comes from.
  local dir="$1" cache tok tmp code now name
  cache="$(usage_cache "$dir")"
  now=$(date +%s)
  # CA_FORCE ignores the cache age without deleting the cache, so a failed
  # fetch still leaves the last known figure in place.
  if [ "${CA_FORCE:-0}" != 1 ] && [ -f "$cache" ] \
     && [ $(( now - $(stat -c%Y "$cache") )) -lt "$USAGE_TTL" ]; then
    return 0
  fi
  tok="$(py token "$dir" 2>/dev/null)" || return 1
  [ -n "$tok" ] || return 1
  tmp="$cache.tmp.$$"
  code="$(curl -s -o "$tmp" -w '%{http_code}' -m 20 \
    https://api.anthropic.com/api/oauth/usage \
    -H "Authorization: Bearer $tok" \
    -H 'anthropic-beta: oauth-2025-04-20' 2>/dev/null)" || { rm -f "$tmp"; printf 'curl-failed' > "$cache.err"; return 1; }
  if [ "$code" = 200 ] && python3 -c 'import json,sys;json.load(open(sys.argv[1]))["limits"]' "$tmp" 2>/dev/null; then
    mv "$tmp" "$cache"
    rm -f "$cache.err"
    name="$(slug_of_dir "$dir")"
    py history-append "$name" "$dir" 2>/dev/null || true
    return 0
  fi
  rm -f "$tmp"
  printf '%s' "${code:-curl-failed}" > "$cache.err"
  return 1
}

usage_err() {  # $1 = profile dir. Prints the recorded failure code, if any.
  local f; f="$(usage_cache "$1").err"
  [ -f "$f" ] && cat "$f"
  return 0
}

refresh_some() {  # refresh the named accounts at once, so a cold cache is one
  # round trip rather than eight. Each child writes only its own files.
  local n pids=()
  for n in "$@"; do
    [ -d "$ROOT/$n" ] || continue
    refresh_usage "$ROOT/$n" & pids+=("$!")
  done
  [ ${#pids[@]} -gt 0 ] && { wait "${pids[@]}" 2>/dev/null || true; }
  return 0
}

refresh_all() {
  local -a all=()
  mapfile -t all < <(cmd_list)
  [ ${#all[@]} -gt 0 ] && refresh_some "${all[@]}"
  return 0
}

# ------------------------------------------------------------------ listing ---
cmd_list() {
  [ -d "$ROOT" ] || return 0
  local p
  for p in "$ROOT"/*; do
    [ -d "$p" ] || continue
    case "$(basename "$p")" in .*) continue ;; esac
    basename "$p"
  done
}

slug_of_dir() {  # name a profile dir by its registered account name, else its basename
  local d n
  d="$(readlink -f "$1")"
  while read -r n; do
    [ -n "$n" ] || continue
    [ "$(readlink -f "$ROOT/$n")" = "$d" ] && { printf '%s' "$n"; return 0; }
  done < <(cmd_list)
  printf '%s' "$(basename "$d")"
}

cmd_status() {
  refresh_all
  ensure_refresh_timer
  py status
  if ! wrapper_ok; then
    printf '\nbare "claude" is NOT routed to an account any more: %s is not the wrapper.\n' \
      "$(command -v claude 2>/dev/null || echo 'claude')"
    printf 'A Claude update replaces it. Restore it with:  claude-acct wrapper\n'
  fi
  [ -f "$CANON/.credentials.json" ] && \
    printf 'a login sits at the shared location (~/.claude/.credentials.json); run: claude-acct claim\n'
  if [ -s "$ROOT/.identity-log" ]; then
    printf '\nlast account change seen by the session guard:\n  %s\n' "$(tail -1 "$ROOT/.identity-log")"
  fi
  return 0
}

cmd_forecast() {
  refresh_all
  py forecast "$@"
}

cmd_whoami() {
  local d="${CLAUDE_CONFIG_DIR:-$CANON}" info
  refresh_usage "$d" || true
  info="$(acct_info "$d")"
  printf '%s  %s / %s  ·  %s  ·  session %s%%  weekly %s%%  fable %s%%  ·  binding %s %s%%  (%s)\n' \
    "$(slug_of_dir "$d")" "$(field "$info" 3)" "$(field "$info" 4)" "$(field "$info" 5)" \
    "$(field "$info" 7)" "$(field "$info" 8)" "$(field "$info" 11)" \
    "$(field "$info" 12)" "$(field "$info" 13)" "$(field "$info" 1)"
  printf 'config: %s\n' "$(cfg_json "$d")"
}

# ------------------------------------------------------------ project chain ---
chain_file() {
  local d
  d="$(cd "${1:-$PWD}" 2>/dev/null && pwd)" || return 1
  while :; do
    { [ "$d" = "$HOME" ] || [ "$d" = "/" ]; } && break
    [ -f "$d/.claude/accounts" ] && { printf '%s' "$d/.claude/accounts"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

read_chain() {
  local f
  if f="$(chain_file "${1:-$PWD}")"; then
    grep -vE '^[[:space:]]*(#|$)' "$f" | awk '{print $1}'
  fi
}

# ~/.claude-accounts/default is the machine-wide chain for any directory without
# its own .claude/accounts. Like a project chain it is a set of allowed accounts,
# scored the same way; order only breaks ties. Its first line is also
# default_first, the fallback seed account when ~/.claude-accounts/seed is unset.
read_default_chain() {
  [ -f "$ROOT/default" ] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$ROOT/default" | awk '{print $1}'
}
default_first() { read_default_chain | head -n1; }
seed_account() {  # the account new profiles inherit answered questions from
  local n
  if [ -f "$ROOT/seed" ]; then
    n="$(grep -vE '^[[:space:]]*(#|$)' "$ROOT/seed" | awk '{print $1}' | head -n1)"
    [ -n "$n" ] && [ -d "$ROOT/$n" ] && { printf '%s' "$n"; return 0; }
    warn "$ROOT/seed names an unusable account; falling back to the chain"
  fi
  default_first
}
default_add() {  # append an account to the machine-wide chain if it is missing
  read_default_chain | grep -qx "$1" && return 0
  printf '%s\n' "$1" >> "$ROOT/default"
}

cmd_bind() {
  local dir="$PWD" f n
  if [ "${1:-}" = "--show" ]; then
    if f="$(chain_file "$dir")"; then printf 'from %s\n' "$f"; read_chain "$dir"
    else printf 'no chain for %s; using the machine-wide chain (%s)\n' "$dir" "$ROOT/default"; read_default_chain; fi
    return 0
  fi
  [ $# -gt 0 ] || die "usage: claude-acct bind <account> [account...]   |   bind --show"
  for n in "$@"; do [ -d "$ROOT/$n" ] || die "no such account: $n (see claude-acct status)"; done
  mkdir -p "$dir/.claude"
  { printf '# Accounts for this project, in preference order.\n'
    printf '# First line is the default; the rest take over when it nears its limit.\n'
    printf '%s\n' "$@"; } > "$dir/.claude/accounts"
  printf 'bound %s -> %s\n' "$dir" "$*"
}

# Which seat a new pane should take. The chain says which accounts are allowed;
# the score says which of them has budget that would otherwise expire unused.
cmd_pick() {
  local -a chain=()
  mapfile -t chain < <(read_chain "${1:-$PWD}")
  [ ${#chain[@]} -eq 0 ] && mapfile -t chain < <(read_default_chain)
  [ ${#chain[@]} -eq 0 ] && mapfile -t chain < <(cmd_list)
  [ ${#chain[@]} -eq 0 ] && die "no accounts registered (run: claude-acct adopt)"

  # A takeover has to be able to leave the project chain. Widen to the
  # machine-wide chain and then every account, in order, rather than refusing
  # because the project pinned a single account.
  if [ "${CLAUDE_ACCT_ANY:-0}" = 1 ]; then
    local -a wide=(); local q seen=""
    for q in "${chain[@]}" $(read_default_chain) $(cmd_list); do
      [ -n "$q" ] || continue
      case " $seen " in *" $q "*) continue ;; esac
      seen="$seen $q"; wide+=("$q")
    done
    chain=("${wide[@]}")
  fi

  refresh_some "${chain[@]}"
  local -a args=()
  [ "${CLAUDE_ACCT_PICK:-}" = "fewest-live" ] && args+=(--fewest-live)
  [ -n "${CLAUDE_ACCT_EXCLUDE:-}" ] && args+=(--exclude "$CLAUDE_ACCT_EXCLUDE")
  py pick "${args[@]}" "${chain[@]}" || die "no usable account in chain: ${chain[*]}"
}

# ------------------------------------------------------------------- slices ---
ensure_slices() {
  local n="$1" changed=0 unit tmp
  mkdir -p "$SLICE_DIR"
  tmp="$(mktemp)"
  cat > "$tmp" <<EOF
[Unit]
Description=All Claude Code sessions on this machine

[Slice]
MemoryMax=$POOL_MEMMAX
MemorySwapMax=0
CPUQuota=$POOL_CPUQUOTA
EOF
  if ! cmp -s "$tmp" "$SLICE_DIR/claude.slice"; then
    cp "$tmp" "$SLICE_DIR/claude.slice"; changed=1
  fi
  # No MemoryMax per account: kernel slab (e.g. dentry cache from a find /) is
  # charged to the cgroup and OOM-kills unrelated sessions on that account
  # while the machine has memory to spare. The pool slice keeps the cap.
  unit="$(slice_unit "$n")"
  cat > "$tmp" <<EOF
[Unit]
Description=Claude Code sessions for account $n

[Slice]
MemorySwapMax=0
EOF
  if ! cmp -s "$tmp" "$SLICE_DIR/$unit"; then
    cp "$tmp" "$SLICE_DIR/$unit"; changed=1
  fi
  rm -f "$tmp"
  [ "$changed" = 1 ] && systemctl --user daemon-reload
  return 0
}

# --------------------------------------------------------------- refreshing ---
# The burn rates are only as good as the history, and the history only grows
# when someone fetches. So a timer fetches every ten minutes whether or not a
# pane happens to run status.
ensure_refresh_timer() {
  local changed=0 tmp
  command -v systemctl >/dev/null 2>&1 || return 0
  mkdir -p "$SLICE_DIR"
  tmp="$(mktemp)"
  cat > "$tmp" <<EOF
[Unit]
Description=Refresh the Claude account usage snapshots and history

[Service]
Type=oneshot
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$HOME/.local/bin/claude-acct refresh
# One account failing to answer is normal (an expired access token refreshes
# when a session next starts on it), and must not mark the timer failed.
SuccessExitStatus=0 1
EOF
  if ! cmp -s "$tmp" "$SLICE_DIR/claude-acct-refresh.service"; then
    cp "$tmp" "$SLICE_DIR/claude-acct-refresh.service"; changed=1
  fi
  cat > "$tmp" <<'EOF'
[Unit]
Description=Refresh the Claude account usage every 10 minutes

[Timer]
OnActiveSec=1min
OnUnitActiveSec=10min
AccuracySec=30s

[Install]
WantedBy=timers.target
EOF
  if ! cmp -s "$tmp" "$SLICE_DIR/$REFRESH_TIMER"; then
    cp "$tmp" "$SLICE_DIR/$REFRESH_TIMER"; changed=1
  fi
  rm -f "$tmp"
  chmod 644 "$SLICE_DIR/claude-acct-refresh.service" "$SLICE_DIR/$REFRESH_TIMER"
  [ "$changed" = 1 ] && systemctl --user daemon-reload
  systemctl --user is-active --quiet "$REFRESH_TIMER" && return 0
  systemctl --user enable --now "$REFRESH_TIMER" >/dev/null 2>&1 \
    || warn "could not start $REFRESH_TIMER; run: systemctl --user enable --now $REFRESH_TIMER"
  return 0
}

cmd_refresh() {
  local -a names=()
  if [ -n "${1:-}" ]; then names=("$1"); else mapfile -t names < <(cmd_list); fi
  ensure_refresh_timer
  local n ok=0 bad=0
  CA_FORCE=1 refresh_some "${names[@]}"
  for n in "${names[@]}"; do
    [ -d "$ROOT/$n" ] || continue
    if [ -z "$(usage_err "$ROOT/$n")" ]; then printf '%-26s refreshed\n' "$n"; ok=$((ok+1))
    else printf '%-26s FAILED (%s)\n' "$n" "$(usage_err "$ROOT/$n")"; bad=$((bad+1)); fi
  done
  if [ "$bad" -gt 0 ]; then
    printf '429 or 401 with 0 live sessions usually means the access token expired; it refreshes when a session starts on that account\n'
    [ "$ok" = 0 ] && return 1
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------- run ---
cmd_run() {
  local name="" use_slice=1 bypass=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--account) name="${2:?account name}"; shift 2 ;;
      --no-slice)   use_slice=0; shift ;;
      --no-bypass)  bypass=0; shift ;;
      --)           shift; break ;;
      *)            break ;;
    esac
  done
  [ -n "$name" ] || name="$(cmd_pick "$PWD")"
  local dir="$ROOT/$name"
  [ -d "$dir" ] || die "no such account: $name"

  local -a argv=("$(real_claude_binary)")
  [ -f "$CANON_SETTINGS" ] && argv+=(--settings "$CANON_SETTINGS")
  [ "$bypass" = 1 ] && argv+=(--dangerously-skip-permissions)
  argv+=("$@")

  export CLAUDE_ACCT_NAME="$name"
  local -a envopts=(--setenv=CLAUDE_ACCT_NAME)
  if is_primary "$dir"; then
    unset CLAUDE_CONFIG_DIR          # the default account IS the default location
  else
    export CLAUDE_CONFIG_DIR="$(readlink -f "$dir")"
    envopts+=(--setenv=CLAUDE_CONFIG_DIR)
  fi

  if [ "$use_slice" = 1 ]; then
    command -v systemd-run >/dev/null 2>&1 || \
      die "systemd-run is unavailable; re-run with --no-slice to accept no memory cap"
    ensure_slices "$name"
    exec systemd-run --user --scope --quiet --collect \
      --slice="$(slice_unit "$name")" "${envopts[@]}" -- "${argv[@]}"
  fi
  exec "${argv[@]}"
}

# ----------------------------------------------------------- profile building --
build_profile() {
  local dir="$1" d
  mkdir -p "$dir"
  [ -e "$dir/projects" ] || ln -s "$SHARED_PROJECTS" "$dir/projects"
  for d in "${LINK_DIRS[@]}"; do
    [ -d "$CANON/$d" ] || continue
    [ -e "$dir/$d" ] || ln -s "$CANON/$d" "$dir/$d"
  done
  # A real one-line file, never a symlink: Claude rewrites CLAUDE.md atomically,
  # which would replace a symlink with a plain file and silently unshare it.
  if [ -f "$CANON/CLAUDE.md" ] && [ ! -e "$dir/CLAUDE.md" ]; then
    printf '@%s/CLAUDE.md\n' "$CANON" > "$dir/CLAUDE.md"
  fi
}

seed_source() {  # where the answered-questions state actually lives now
  local d
  if [ -f "$ROOT/default" ]; then
    d="$(seed_account)"
    if [ -n "$d" ] && [ -d "$ROOT/$d" ] && [ -f "$(cfg_json "$ROOT/$d")" ]; then
      printf '%s' "$(cfg_json "$ROOT/$d")"; return 0
    fi
  fi
  printf '%s' "$PRIMARY_CFG"
}

seed_state() { py seed "$(seed_source)" "$1/.claude.json"; }

derive_slug_raw() {  # email -> the name it would get, ignoring collisions
  printf '%s' "${1%%@*}" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//'
}

org_suffix() {  # organizationName -> short slug; a personal plan's own org is "personal"
  case "$1" in
    *"'s Organization"|*"’s Organization"|"") printf 'personal' ;;
    *) printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' ;;
  esac
}

derive_slug() {  # email [cfg] -> account name, disambiguated on collision
  # Same local part, other domain: suffix the domain. Same email again, which
  # means the same login in another organization: suffix that organization.
  local email="$1" cfg="${2:-}" slug
  [ -n "$email" ] || die "no email in the account config; cannot name the account"
  slug="$(derive_slug_raw "$email")"
  [ -n "$slug" ] || die "could not derive a name from email: $email"
  if [ -e "$ROOT/$slug" ]; then
    if [ -n "$cfg" ] && [ "$(field "$(acct_info "$ROOT/$slug")" 2)" = "$email" ]; then
      slug="$slug-$(org_suffix "$(py orgname "$cfg")")"
    else
      local dom="${email#*@}"
      slug="$slug-$(printf '%s' "${dom%%.*}" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')"
    fi
  fi
  printf '%s' "$slug"
}

acct_uuid() { py uuid "$1"; }

cmd_adopt() {
  mkdir -p "$ROOT"
  local info email slug n
  info="$(acct_info "$CANON")"
  case "$(field "$info" 1)" in
    ok|nousage) ;;
    *) die "$PRIMARY_CFG has no usable login ($(field "$info" 1)); nothing to adopt" ;;
  esac
  email="$(field "$info" 2)"
  slug="$(derive_slug "$email" "$PRIMARY_CFG")"
  local existing=""
  while read -r n; do
    [ -n "$n" ] || continue
    if [ -L "$ROOT/$n" ] && is_primary "$ROOT/$n"; then existing="$n"; break; fi
  done < <(cmd_list)

  if [ "$existing" = "$slug" ]; then
    printf 'already adopted: %s -> %s\n' "$slug" "$CANON"
  elif [ -n "$existing" ]; then
    warn "the default account is now $email, but it is registered as \"$existing\""
    rm "$ROOT/$existing"
    ln -s "$CANON" "$ROOT/$slug"
    [ "$(default_first)" = "$existing" ] && sed -i "0,/^${existing}\$/s//${slug}/" "$ROOT/default"
    rm -f "$SLICE_DIR/$(slice_unit "$existing")"
    printf 'renamed account "%s" -> "%s"\n' "$existing" "$slug"
    warn "any project bound to \"$existing\" needs: claude-acct bind $slug"
  else
    ln -s "$CANON" "$ROOT/$slug"
    printf 'adopted %s as account "%s"\n' "$email" "$slug"
  fi
  [ -f "$ROOT/default" ] || printf '%s\n' "$slug" > "$ROOT/default"
  ensure_slices "$slug"
  printf 'default account: %s\n' "$(cat "$ROOT/default")"
}

cmd_add() {
  mkdir -p "$ROOT"
  if [ "${1:-}" = "--finish" ]; then shift; add_finish "$@"; return; fi
  if [ "${1:-}" = "--discard" ]; then
    [ -d "$STAGING" ] || die "nothing is staged"
    local bk="$ROOT/.discarded-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$bk"; chmod 700 "$bk"
    [ -f "$STAGING/.credentials.json" ] && mv "$STAGING/.credentials.json" "$bk/"
    rm -rf "$STAGING"
    printf 'discarded the staged login (its credentials kept in %s)\n' "$bk"
    return 0
  fi
  [ -f "$ROOT/default" ] || die 'run "claude-acct adopt" first, so your existing account is registered'

  if [ -d "$STAGING" ]; then
    local sst sinfo semail suuid dup="" n
    sinfo="$(acct_info "$STAGING")"
    sst="$(field "$sinfo" 1)"
    case "$sst" in
      ok|nousage)
        semail="$(field "$sinfo" 2)"
        suuid="$(acct_uuid "$STAGING/.claude.json")"
        while read -r n; do
          [ -n "$n" ] || continue
          [ "$(acct_uuid "$(cfg_json "$ROOT/$n")")" = "$suuid" ] && { dup="$n"; break; }
        done < <(cmd_list)
        if [ -n "$dup" ]; then
          die "the staged login is $semail, which you already have as \"$dup\".
             The approval page reused the Anthropic session you are already
             signed in to, so you logged in as an existing account.
               claude-acct add --discard && claude-acct add    (start over)
               claude-acct add --finish --replace   to renew \"$dup\" instead"
        fi
        die "a finished login for $semail is already staged.
             Promote it with:  claude-acct add --finish
             Discard it with:  claude-acct add --discard" ;;
      *)
        rm -rf "$STAGING"
        printf 'removed a dead staging directory (it held no login)\n' ;;
    esac
  fi
  build_profile "$STAGING"
  printf 'staged a new empty account at %s\n' "$STAGING"

  if [ -t 0 ] && [ -t 1 ]; then
    printf '\nYou already have these seats, so do NOT pick the same email in the same organization:\n'
    local n e
    while read -r n; do
      [ -n "$n" ] || continue
      e="$(field "$(acct_info "$ROOT/$n")" 2)"
      [ -n "$e" ] && printf '  %s in %s   (%s)\n' "$e" "$(py orgname "$(cfg_json "$ROOT/$n")")" "$n"
    done < <(cmd_list)

    cat <<EOF

The approval page signs you in as whoever the browser is ALREADY signed in as,
without asking. That is the only thing that makes this fail, so deal with it
before you start. Do one of these, in the browser you are about to use:

  a) Sign out of claude.ai   (profile menu, bottom left -> Log out)
  b) Use a browser you have never signed in with
  c) Use a FRESH private window. One left open from a previous attempt is
     already signed in and will silently reuse that account.

Then:
  1. press Enter here; Claude must say "Not logged in"
  2. type /login and open the link it prints
  3. the page should ask you to SIGN IN. If it instead shows an approve button
     for an account you already have, stop: the browser is still signed in.
  4. if the account belongs to several organizations (a team seat AND a
     personal plan), the page asks which one: pick the one you are adding.
     Each organization is its own seat with its own limits.
  5. approve, paste the code back here, then /exit

Press Enter to start Claude in the new account, or Ctrl-C to stop.
EOF
    read -r _
    CLAUDE_CONFIG_DIR="$STAGING" claude --settings "$CANON_SETTINGS" || true
    add_finish
  else
    cat <<EOF

Not a terminal, so the login cannot run here. Run this yourself:

  claude-acct add

By hand instead:
  CLAUDE_CONFIG_DIR=$STAGING claude      # log in as the new account, then /exit
  claude-acct add --finish
EOF
    return 3
  fi
}

add_finish() {
  [ -d "$STAGING" ] || die 'nothing staged; run "claude-acct add" first'
  local replace=0
  [ "${1:-}" = "--replace" ] && replace=1
  local info st email uuid slug n
  info="$(acct_info "$STAGING")"
  st="$(field "$info" 1)"
  case "$st" in
    ok|nousage) ;;
    nologin) die "check 1 of 3 failed: no login was saved in $STAGING.
             It is left in place, so \"claude-acct add\" will retry it." ;;
    expired) die "check 2 of 3 failed: the login in $STAGING is already expired." ;;
    *)       die "check 1 of 3 failed: $STAGING has no usable config ($st)." ;;
  esac
  email="$(field "$info" 2)"
  uuid="$(acct_uuid "$STAGING/.claude.json")"
  while read -r n; do
    [ -n "$n" ] || continue
    if [ "$(acct_uuid "$(cfg_json "$ROOT/$n")")" = "$uuid" ]; then
      if [ "$replace" = 1 ]; then
        local bk="$ROOT/.relogin-backup-$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$bk"; chmod 700 "$bk"
        cp -p "$ROOT/$n/.credentials.json" "$bk/" 2>/dev/null || true
        mv "$STAGING/.credentials.json" "$ROOT/$n/.credentials.json"
        rm -rf "$STAGING"
        rm -f "$(usage_cache "$ROOT/$n")"
        printf 'refreshed the login for existing account "%s" (%s)\n' "$n" "$email"
        printf 'previous credentials kept in %s\n' "$bk"
        cmd_doctor "$n"
        return 0
      fi
      die "check 3 of 3 failed: $email is already registered as \"$n\".
             You logged in as an account you already have, most likely because
             the browser reused a signed-in Anthropic session. Retry with a
             private window, or, if you meant to renew this account's login:
               claude-acct add --finish --replace
             Discard the staged copy with: rm -rf $STAGING"
    fi
  done < <(cmd_list)

  slug="$(derive_slug "$email" "$STAGING/.claude.json")"
  seed_state "$STAGING"
  mv "$STAGING" "$ROOT/$slug"
  ensure_slices "$slug"
  default_add "$slug"
  printf '\nadded account "%s"  (%s)\n\n' "$slug" "$email"
  cmd_status
  printf '\nuse it here with:  claude-acct bind %s %s\n' "$(default_first)" "$slug"
}

# ------------------------------------------------------------------ migrate ---
# Move the default location's login into a real profile, so no session runs on
# the shared location any more. The three files are MOVED, never copied: one
# login must exist in exactly one file, or whichever copy refreshes second can
# be silently logged out.
MOVE_FILES_HOME=(.claude.json)
MOVE_FILES_CANON=(.credentials.json history.jsonl)

cmd_migrate() {
  mkdir -p "$ROOT"
  local live; live="$(shared_location_sessions)"
  if [ "$live" -gt 0 ]; then
    die "$live Claude session(s) are running on the shared location.
             Migrating would log them out mid-work. Close them first."
  fi
  local info email slug n stamp backup
  info="$(acct_info "$CANON")"
  case "$(field "$info" 1)" in
    ok|nousage) ;;
    *) die "the default location has no usable login ($(field "$info" 1)); nothing to migrate" ;;
  esac
  email="$(field "$info" 2)"
  slug="$(derive_slug "$email" "$PRIMARY_CFG")"
  [ -d "$ROOT/$slug" ] && [ ! -L "$ROOT/$slug" ] && \
    die "$ROOT/$slug already exists as a real profile; refusing to overwrite it"

  stamp="$(date +%Y%m%d-%H%M%S)"
  backup="$ROOT/.migration-backup-$stamp"
  mkdir -p "$backup"
  local f
  for f in "${MOVE_FILES_HOME[@]}"; do
    [ -f "$HOME/$f" ] && cp -p "$HOME/$f" "$backup/$f"
  done
  for f in "${MOVE_FILES_CANON[@]}"; do
    [ -f "$CANON/$f" ] && cp -p "$CANON/$f" "$backup/$f"
  done
  chmod 700 "$backup"
  printf 'backup: %s\n' "$backup"

  # drop the old adopt-style registration, which pointed at the shared location
  while read -r n; do
    [ -n "$n" ] || continue
    [ -L "$ROOT/$n" ] && is_primary "$ROOT/$n" && { rm "$ROOT/$n"; printf 'unregistered %s (was the shared location)\n' "$n"; }
  done < <(cmd_list)

  build_profile "$ROOT/$slug"
  for f in "${MOVE_FILES_HOME[@]}"; do
    [ -f "$HOME/$f" ] && mv "$HOME/$f" "$ROOT/$slug/$f" && printf 'moved ~/%s\n' "$f"
  done
  for f in "${MOVE_FILES_CANON[@]}"; do
    [ -f "$CANON/$f" ] && mv "$CANON/$f" "$ROOT/$slug/$f" && printf 'moved ~/.claude/%s\n' "$f"
  done

  if [ "$(default_first)" != "$slug" ]; then
    { printf '%s\n' "$slug"; read_default_chain | grep -vx "$slug"; } > "$ROOT/default.tmp" \
      && mv "$ROOT/default.tmp" "$ROOT/default"
  fi
  ensure_slices "$slug"

  # Fail loudly rather than leave a half-migrated account behind.
  local check; check="$(field "$(acct_info "$ROOT/$slug")" 1)"
  case "$check" in
    ok|nousage) ;;
    *) die "the moved profile does not read back as logged in ($check).
             Roll back with: mv $backup/.claude.json \$HOME/ &&
             mv $backup/.credentials.json $backup/history.jsonl $CANON/" ;;
  esac

  printf '\nmigrated %s to %s\n\n' "$email" "$ROOT/$slug"
  cmd_doctor "$slug"
  cat <<EOF

Rollback, if you want the old layout back:
  mv $backup/.claude.json \$HOME/
  mv $backup/.credentials.json $backup/history.jsonl $CANON/

Next:
  1. smoke test the moved login (proves the profile really authenticates):
       claude-acct run -a $slug -- -p ok
  2. bare "claude" now has no login, on purpose: the shared location is dead.
     To keep typing "claude", add this to your ~/.bashrc and ~/.zshrc yourself:
       export CLAUDE_CONFIG_DIR="\$HOME/.claude-accounts/$slug"
     Without it, use "claude-acct run", which also picks the account per project.
  3. add the second account when you have a browser:
       claude-acct add

Sessions started before now keep working on their cached token until it
expires, then ask you to log in. Restart or re-login them at your own pace.
EOF
}

# -------------------------------------------------------------------- claim ---
# A /login in a session without CLAUDE_CONFIG_DIR writes its credentials to the
# shared default location, even after a migration. That leaves the same login in
# two files, which is the one thing that must never persist: if a refresh
# rotates the token, whichever copy refreshes second is silently logged out.
# claim consolidates it, keeping the newer file and discarding nothing silently.

identity_from_token() {  # -> "email<TAB>uuid", asking Anthropic who this token is
  local tok
  tok="$(py token "$CANON" 2>/dev/null)" || return 1
  [ -n "$tok" ] || return 1
  curl -s -m 25 https://api.anthropic.com/api/oauth/profile \
    -H "Authorization: Bearer $tok" -H "anthropic-beta: oauth-2025-04-20" \
  | py whose-token
}

# A running process cannot be moved to a profile, so taking its credentials
# away logs it out mid-work. Count what is on the shared location before that.
shared_location_sessions() {
  local vdir="$HOME/.local/share/claude/versions/" d n=0
  for d in /proc/[0-9]*; do
    case "$(readlink "$d/exe" 2>/dev/null)" in
      "$vdir"*) ;;
      *) continue ;;
    esac
    grep -qz "^CLAUDE_CONFIG_DIR=" "$d/environ" 2>/dev/null || n=$((n+1))
  done
  printf '%s' "$n"
}

wrapper_ok() {  # is bare `claude` still routed to the project's account?
  local w; w="$(command -v claude 2>/dev/null)" || return 1
  grep -q 'claude-acct run' "$w" 2>/dev/null
}

cmd_claim() {
  mkdir -p "$ROOT"
  local force=0
  [ "${1:-}" = "--force" ] && force=1
  local cred="$CANON/.credentials.json"
  [ -f "$cred" ] || die "no login sits at the shared location; nothing to claim"

  if [ "$force" = 0 ]; then
    local live; live="$(shared_location_sessions)"
    if [ "$live" -gt 0 ]; then
      die "$live Claude session(s) are running on the shared location right now.
             Taking this login away would log them out mid-work, and a running
             session cannot be moved to a profile. Close them first, or pass
             --force if you accept logging them out."
    fi
  fi

  local email uuid ident
  if [ -f "$PRIMARY_CFG" ]; then
    ident="$(acct_info "$CANON")"
    email="$(field "$ident" 2)"
    uuid="$(acct_uuid "$PRIMARY_CFG")"
  fi
  if [ -z "${uuid:-}" ]; then
    printf 'asking Anthropic which account this login belongs to...\n' >&2
    ident="$(identity_from_token)" || \
      die "could not identify the login at $cred (the profile request failed).
             Start one session there so Claude writes its own identity file, or
             remove the file if it is a leftover."
    email="$(printf '%s' "$ident" | cut -f1)"
    uuid="$(printf '%s' "$ident" | cut -f2)"
  fi
  printf 'the shared location holds: %s\n' "$email"

  local n existing=""
  while read -r n; do
    [ -n "$n" ] || continue
    [ "$(acct_uuid "$(cfg_json "$ROOT/$n")")" = "$uuid" ] && { existing="$n"; break; }
  done < <(cmd_list)

  local stamp backup slug
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup="$ROOT/.claim-backup-$stamp"
  mkdir -p "$backup"; chmod 700 "$backup"

  if [ -n "$existing" ]; then
    slug="$existing"
    printf 'that account already has the profile "%s"\n' "$slug"
    if [ -f "$ROOT/$slug/.credentials.json" ]; then
      if cmp -s "$cred" "$ROOT/$slug/.credentials.json"; then
        rm "$cred"
        printf 'the two files were identical; removed the shared copy\n'
        [ -f "$PRIMARY_CFG" ] && mv "$PRIMARY_CFG" "$backup/.claude.json" && \
          printf 'moved a stray ~/.claude.json to the backup\n'
        rmdir "$backup" 2>/dev/null || true
        return 0
      fi
      cp -p "$ROOT/$slug/.credentials.json" "$backup/profile.credentials.json"
      printf 'kept the older profile copy in %s\n' "$backup"
    fi
    mv "$cred" "$ROOT/$slug/.credentials.json"
    printf 'the newer login now lives only in %s\n' "$ROOT/$slug"
  else
    slug="$(derive_slug "$email" "$PRIMARY_CFG")"
    build_profile "$ROOT/$slug"
    mv "$cred" "$ROOT/$slug/.credentials.json"
    [ -f "$PRIMARY_CFG" ] && mv "$PRIMARY_CFG" "$ROOT/$slug/.claude.json"
    [ -f "$CANON/history.jsonl" ] && mv "$CANON/history.jsonl" "$ROOT/$slug/history.jsonl"
    seed_state "$ROOT/$slug" 2>/dev/null || true
    ensure_slices "$slug"
    printf 'created account "%s" from the login at the shared location\n' "$slug"
  fi

  # A stray ~/.claude.json left behind would make the dead location look alive.
  if [ -f "$PRIMARY_CFG" ]; then
    mv "$PRIMARY_CFG" "$backup/.claude.json"
    printf 'moved the leftover ~/.claude.json to %s\n' "$backup"
  fi

  local check; check="$(field "$(acct_info "$ROOT/$slug")" 1)"
  case "$check" in
    ok|nousage) ;;
    *) die "profile $slug does not read back as logged in ($check); backup: $backup" ;;
  esac
  printf '\n'; cmd_doctor "$slug"
  printf '\nsmoke test it with:  claude-acct run -a %s -- -p ok\n' "$slug"
}

cmd_wrapper() {  # (re)install the bare-`claude` router
  local dest="$HOME/.local/bin/claude"
  real_claude_binary >/dev/null
  rm -f "$ROOT/claude-binary"   # the old fixed pin; the newest version is used now
  cat > "$dest.tmp" <<'WRAP'
#!/usr/bin/env bash
# Route a bare `claude` to the account this directory is bound to.
#
# The shared default location holds no login on purpose, so without this a plain
# `claude` asks for /login in every pane. With CLAUDE_CONFIG_DIR already set we
# are being called *by* claude-acct, so run the real binary and do not recurse.
set -u

real_binary() {  # newest installed version; `claude update` only adds to versions/
    local newest
    newest="$(ls -1d "$HOME"/.local/share/claude/versions/* 2>/dev/null | sort -V | tail -1)"
    [ -x "$newest" ] || return 1
    printf '%s' "$newest"
}

bin="$(real_binary)" || {
    printf 'claude: no installed binary under ~/.local/share/claude/versions\n' >&2
    exit 127
}

if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    exec -a claude "$bin" "$@"
fi

if command -v claude-acct >/dev/null 2>&1; then
    exec claude-acct run -- "$@"
fi

printf 'claude: claude-acct is not on PATH, so no account was selected\n' >&2
exec -a claude "$bin" "$@"
WRAP
  chmod 755 "$dest.tmp"; mv "$dest.tmp" "$dest"
  printf 'bare "claude" now routes through claude-acct\n'
  printf 'real binary: %s (newest installed; restarts pick up updates)\n' "$(real_claude_binary)"
}

cmd_backup() {
  local dest="$ROOT/.logins-backup-$(date +%Y%m%d-%H%M%S)" n f count=0
  mkdir -p "$dest"; chmod 700 "$dest"
  while read -r n; do
    [ -n "$n" ] || continue
    f="$(creds_json "$ROOT/$n")"
    if [ -f "$f" ] && py creds-ok "$f"; then
      cp -p "$f" "$dest/$n.credentials.json"
      printf '  %-26s saved\n' "$n"
      count=$((count+1))
    else
      printf '  %-26s SKIPPED (no valid login in %s)\n' "$n" "$f"
    fi
  done < <(cmd_list)
  if [ -f "$CANON/.credentials.json" ]; then
    cp -p "$CANON/.credentials.json" "$dest/_shared-location.credentials.json"
    printf '  %-26s saved\n' "(shared location)"
    count=$((count+1))
  fi
  chmod 600 "$dest"/* 2>/dev/null || true
  printf '\n%s login file(s) copied to %s\n' "$count" "$dest"
  printf 'restore one with:  cp %s/<name>.credentials.json %s/<name>/.credentials.json\n' \
    "$dest" "$ROOT"
}

cmd_trust() {
  local n="${1:?usage: claude-acct trust <account>}"
  [ -d "$ROOT/$n" ] || die "no such account: $n"
  printf 'source: %s\n' "$(seed_source)"
  seed_state "$ROOT/$n"
}

cmd_doctor() {
  local n="${1:-$(slug_of_dir "${CLAUDE_CONFIG_DIR:-$CANON}")}" dir="$ROOT/${1:-}" info d target
  [ -n "${1:-}" ] || dir="$ROOT/$n"
  [ -d "$dir" ] || die "no such account: $n"
  info="$(acct_info "$dir")"
  printf 'account %s -> %s\n' "$n" "$(readlink -f "$dir")"
  printf '  login       %s\n' "$(field "$info" 1)"
  printf '  identity    %s / %s  (%s)\n' "$(field "$info" 3)" "$(field "$info" 4)" "$(field "$info" 2)"
  printf '  plan        %s  (x%s: one week is %s u)\n' "$(field "$info" 5)" \
    "$(field "$info" 14)" "$(( 100 * $(field "$info" 14) ))"
  printf '  usage       session %s%%  weekly %s%%  fable %s%%  ·  binding %s at %s%%\n' \
    "$(field "$info" 7)" "$(field "$info" 8)" "$(field "$info" 11)" \
    "$(field "$info" 12)" "$(field "$info" 13)"
  printf '  config      %s\n' "$(cfg_json "$dir")"
  local want dom; want="$(derive_slug_raw "$(field "$info" 2)")"
  if [ -n "$want" ] && [ "$want" != "$n" ]; then
    case "$n" in
      "$want"-*) ;;  # disambiguated by domain or organization
      *) printf '  name        STALE: this login would be named "%s" now (run: claude-acct adopt)\n' "$want" ;;
    esac
  fi
  if is_primary "$dir"; then
    printf '  sharing     canonical: this account owns projects/, skills/, hooks/, settings.json\n'
    printf '  launch      no CLAUDE_CONFIG_DIR (Claude default location)\n'
  else
    for d in projects "${LINK_DIRS[@]}"; do
      if [ -L "$dir/$d" ]; then
        target="$(readlink -f "$dir/$d")"
        if [ -d "$target" ]; then printf '  %-11s shared -> %s\n' "$d" "$target"
        else printf '  %-11s BROKEN LINK -> %s\n' "$d" "$(readlink "$dir/$d")"; fi
      elif [ -e "$dir/$d" ]; then
        printf '  %-11s NOT SHARED: a plain %s, so it has drifted\n' "$d" \
          "$([ -d "$dir/$d" ] && echo directory || echo file)"
      else
        printf '  %-11s missing\n' "$d"
      fi
    done
    if [ -f "$dir/CLAUDE.md" ] && grep -q "^@$CANON/CLAUDE.md" "$dir/CLAUDE.md"; then
      printf '  CLAUDE.md   imports %s/CLAUDE.md\n' "$CANON"
    else
      printf '  CLAUDE.md   does NOT import %s/CLAUDE.md\n' "$CANON"
    fi
    [ -e "$dir/settings.json" ] && \
      printf '  settings    WARNING: %s/settings.json shadows the canonical file\n' "$dir"
  fi
  printf '  slice       %s\n' \
    "$([ -f "$SLICE_DIR/$(slice_unit "$n")" ] && slice_unit "$n" || echo missing)"
  return 0
}

# ----------------------------------------------------------------- takeover ---
# Continue this project's work under a different account. The chat lives in the
# shared projects/ directory, so any account can resume it. --fork-session gives
# the continuation its own id, so the original chat is never written to by two
# accounts at once.
cmd_takeover() {
  local name="" sid="" print_only=0 cur
  cur="${CLAUDE_ACCT_NAME:-$(slug_of_dir "${CLAUDE_CONFIG_DIR:-$CANON}")}"
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--account) name="${2:?account name}"; shift 2 ;;
      -s|--session) sid="${2:?session id}"; shift 2 ;;
      --print)      print_only=1; shift ;;
      *)            break ;;
    esac
  done

  if [ -z "$sid" ]; then
    sid="${CLAUDE_CODE_SESSION_ID:-}"
  fi
  if [ -z "$sid" ]; then
    local pdir newest
    pdir="$SHARED_PROJECTS/$(printf '%s' "$(cd "$PWD" && pwd)" | tr '/' '-')"
    [ -d "$pdir" ] || die "no chats recorded for $PWD, so there is nothing to take over"
    newest="$(ls -t "$pdir"/*.jsonl 2>/dev/null | head -1)" || true
    [ -n "$newest" ] || die "no chats recorded for $PWD, so there is nothing to take over"
    sid="$(basename "$newest" .jsonl)"
    warn "no session given; taking over the newest chat in this directory ($sid)"
  fi

  if [ -z "$name" ]; then
    CLAUDE_ACCT_EXCLUDE="$cur" CLAUDE_ACCT_ANY=1 name="$(cmd_pick "$PWD")" \
      || die "no other account is available to take over from $cur"
  fi
  [ "$name" = "$cur" ] && die "$name is already the current account"
  [ -d "$ROOT/$name" ] || die "no such account: $name"

  if [ "$print_only" = 1 ]; then
    printf 'claude-acct run -a %s -- --resume %s --fork-session\n' "$name" "$sid"
    return 0
  fi
  printf 'handing this chat to %s (a forked copy; the original stays with %s)\n' "$name" "$cur" >&2
  cmd_run -a "$name" -- --resume "$sid" --fork-session
}

usage() {
  cat <<'EOF'
claude-acct - several Claude accounts on one machine, as one budget

  claude-acct status                 how full every account is, and the pool
  claude-acct forecast [--json]      per-day budget, burn, slack, and the pick
  claude-acct refresh [NAME]         force a live usage fetch now
  claude-acct backup                 snapshot every account's login file
  claude-acct wrapper                re-route bare "claude" after a Claude update
  claude-acct whoami                 which account this shell is on
  claude-acct pick [dir]             name the best account for a directory
  claude-acct run [-a NAME] [args]   start Claude on that account
  claude-acct migrate                move the default location's login into a profile
  claude-acct claim                  adopt a login that /login left at the shared location
                                     (refuses while sessions still use it)
  claude-acct adopt                  register the existing account as number one
  claude-acct add                    add another account (guided login)
  claude-acct add --finish           finish an add you did by hand
  claude-acct add --finish --replace renew an existing account's login instead
  claude-acct add --discard          throw away a staged login and start over
  claude-acct takeover [-a NAME]     continue this chat on another account
  claude-acct bind NAME [NAME...]    set this project's accounts, in order
  claude-acct bind --show            show this project's accounts
  claude-acct trust NAME             copy your trusted-folder answers to an account
  claude-acct doctor [NAME]          check one account's sharing and login
  claude-acct list                   account names, one per line
  claude-acct timer                  install the 10-minute usage-history timer

Everything summed is in u: 1 u is one percentage point of one week of a 1x
account, so a max-5x week is 500 u. pick takes the account whose remaining
budget would otherwise expire soonest (highest slack-in-u per hour to reset).

run passes --settings ~/.claude/settings.json and --dangerously-skip-permissions
(--no-bypass turns the latter off) inside a per-account slice under the claude.slice memory pool.

env: CLAUDE_ACCT_THRESHOLD (80)  CLAUDE_ACCT_PICK (score|fewest-live)
     CLAUDE_ACCT_USAGE_TTL (300)  CLAUDE_ACCT_SESSION_BURN (0.4 pct/h)
     CLAUDE_ACCT_POOL_MEMMAX (40G)  CLAUDE_ACCT_ROOT
EOF
}

case "${1:-status}" in
  status)   shift || true; cmd_status ;;
  forecast) shift || true; cmd_forecast "$@" ;;
  list)     shift || true; cmd_list ;;
  whoami)   shift || true; cmd_whoami ;;
  pick)     shift || true; cmd_pick "${1:-$PWD}" ;;
  run)      shift || true; cmd_run "$@" ;;
  adopt)    shift || true; cmd_adopt ;;
  add)      shift || true; cmd_add "$@" ;;
  bind)     shift || true; cmd_bind "$@" ;;
  migrate)  shift || true; cmd_migrate ;;
  claim)    shift || true; cmd_claim "$@" ;;
  trust)    shift || true; cmd_trust "$@" ;;
  refresh)  shift || true; cmd_refresh "${1:-}" ;;
  timer)    shift || true; ensure_refresh_timer; systemctl --user list-timers --no-pager "$REFRESH_TIMER" ;;
  backup)   shift || true; cmd_backup ;;
  wrapper)  shift || true; cmd_wrapper ;;
  takeover) shift || true; cmd_takeover "$@" ;;
  doctor)   shift || true; cmd_doctor "$@" ;;
  -h|--help|help) usage ;;
  *)        usage; exit 2 ;;
esac
