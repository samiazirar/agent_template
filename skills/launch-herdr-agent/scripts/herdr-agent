#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: herdr-agent <opencode|opencode-high|opencode-xhigh|opencode-max|opencode-luna-low|opencode-luna|codex-low|codex|codex-high|codex-xhigh|codex-max|claude|claudex|claudex-high|terra|terra-high|luna-low|luna|luna-max> "Role · PersonName Goal" [working-directory]\n' >&2
}

if [ "${HERDR_ENV:-}" != "1" ]; then
    printf 'herdr-agent must be run from inside a Herdr-managed pane.\n' >&2
    exit 2
fi

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    usage
    exit 2
fi

surface="$1"
label="$2"
launch_dir="${3:-$PWD}"
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
launch_env=()

configure_opencode() {
    local model="$1"
    local effort="$2"
    local config
    if ! command -v opencode >/dev/null 2>&1; then
        printf 'OpenCode is unavailable.\n' >&2
        exit 2
    fi
    local auth_output
    auth_output="$(opencode auth list 2>/dev/null || true)"
    if ! grep -q 'OpenAI.*oauth' <<<"$auth_output"; then
        printf 'OpenCode has no OpenAI OAuth login. Run opencode, use /connect, and select OpenAI then ChatGPT Plus/Pro.\n' >&2
        exit 2
    fi
    if ! python3 - "${XDG_DATA_HOME:-${HOME}/.local/share}/opencode/auth.json" <<'PY'
import json
import sys
import time

try:
    auth = json.load(open(sys.argv[1], encoding="utf-8"))["openai"]
    valid = auth.get("type") == "oauth" and int(auth.get("expires", 0)) > int(time.time() * 1000) + 60_000
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
    valid = False
raise SystemExit(0 if valid else 1)
PY
    then
        printf 'OpenCode OpenAI OAuth is expired or incomplete. Run: opencode auth login -p openai\n' >&2
        exit 2
    fi
    printf -v config \
        '{"agent":{"build":{"mode":"primary","model":"%s","variant":"%s","permission":{"task":{"*":"deny"}}}}}' \
        "$model" "$effort"
    launch_env=(env "OPENCODE_CONFIG_CONTENT=$config")
    launch_argv=(opencode --agent build --model "$model")
}

if [ -z "$label" ]; then
    printf 'Provide a human task name for the Herdr tab.\n' >&2
    exit 2
fi

if [ ! -d "$launch_dir" ]; then
    printf 'Working directory does not exist: %s\n' "$launch_dir" >&2
    exit 2
fi

case "$surface" in
    opencode)
        configure_opencode openai/gpt-5.6-sol medium
        ;;
    opencode-high)
        configure_opencode openai/gpt-5.6-sol high
        ;;
    opencode-xhigh)
        configure_opencode openai/gpt-5.6-sol xhigh
        ;;
    opencode-max)
        configure_opencode openai/gpt-5.6-sol max
        ;;
    opencode-luna-low)
        configure_opencode openai/gpt-5.6-luna low
        ;;
    opencode-luna)
        configure_opencode openai/gpt-5.6-luna max
        ;;
    codex-low)
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=low)
        ;;
    codex)
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=medium)
        ;;
    codex-high)
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=high)
        ;;
    codex-xhigh)
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=xhigh)
        ;;
    codex-max)
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=max)
        ;;
    terra)
        launch_argv=(codex -m gpt-5.6-terra -c model_reasoning_effort=medium)
        ;;
    terra-high)
        launch_argv=(codex -m gpt-5.6-terra -c model_reasoning_effort=high)
        ;;
    luna-low)
        launch_argv=(codex -m gpt-5.6-luna -c model_reasoning_effort=low)
        ;;
    luna|luna-max)
        launch_argv=(codex -m gpt-5.6-luna -c model_reasoning_effort=max)
        ;;
    claudex|claudex-high)
        claudex_profile="medium"
        if [ "$surface" = "claudex-high" ]; then
            claudex_profile="high"
        fi
        claudex_codex_home="${XDG_CACHE_HOME:-${HOME}/.cache}/herdr/claudex-sol-${claudex_profile}"
        mkdir -p "$claudex_codex_home"
        install -m 600 \
            "$script_dir/../assets/claudex-sol-${claudex_profile}.toml" \
            "$claudex_codex_home/config.toml"
        ln -sfn "${HOME}/.codex/models_cache.json" \
            "$claudex_codex_home/models_cache.json"
        runtime_json="$(
            CODEX_HOME="$claudex_codex_home" claudex --runtime-json
        )"
        runtime_model="$(
            python3 -c 'import json,sys; print(json.load(sys.stdin)["model"])' \
                <<<"$runtime_json"
        )"
        if [ "$runtime_model" != "gpt-5.6-sol" ]; then
            printf 'Claudex is synchronized to %s, expected gpt-5.6-sol.\n' \
                "$runtime_model" >&2
            exit 2
        fi
        launch_env=(env "CODEX_HOME=$claudex_codex_home")
        launch_argv=(claudex)
        ;;
    claude)
        claude_effort="${HERDR_CLAUDE_EFFORT:-medium}"
        case "$claude_effort" in
            low|medium|high|xhigh|max) ;;
            *)
                printf 'Unsupported Claude effort: %s\n' "$claude_effort" >&2
                exit 2
                ;;
        esac
        launch_argv=(claude --model claude-opus-5 --effort "$claude_effort")
        ;;
    *)
        usage
        exit 2
        ;;
esac

if ! command -v "${launch_argv[0]}" >/dev/null 2>&1; then
    printf 'Agent executable is unavailable: %s\n' "${launch_argv[0]}" >&2
    exit 2
fi

tab_json="$(
    herdr tab create \
        --workspace "$HERDR_WORKSPACE_ID" \
        --cwd "$launch_dir" \
        --label "$label" \
        --no-focus
)"

readarray -t created_ids < <(
    python3 -c '
import json
import sys
result = json.load(sys.stdin)["result"]
print(result["tab"]["tab_id"])
print(result["root_pane"]["pane_id"])
' <<<"$tab_json"
)
tab_id="${created_ids[0]}"
pane_id="${created_ids[1]}"

cleanup_failed_launch() {
    herdr tab close "$tab_id" >/dev/null 2>&1 || true
}
trap cleanup_failed_launch ERR

herdr pane rename "$pane_id" "$label" >/dev/null
printf -v launch_command '%q ' "${launch_env[@]}" "${launch_argv[@]}"
herdr pane run "$pane_id" "${launch_command% }" >/dev/null
herdr agent wait "$pane_id" --until idle --until done --timeout 30000 >/dev/null

cost_script="$(readlink -f "$script_dir/../../../runtime/bin/herdr-costs")"
if [ -x "$cost_script" ]; then
    nohup "$cost_script" register \
        --workspace "$HERDR_WORKSPACE_ID" \
        --pane "$pane_id" \
        --parent-pane "$HERDR_PANE_ID" \
        --surface "$surface" \
        --wait-seconds 86400 </dev/null >/dev/null 2>&1 &
fi

trap - ERR
printf 'Ready: %s using %s.\n' "$label" "$surface"
