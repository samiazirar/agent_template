#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: herdr-agent <opencode|opencode-high|opencode-xhigh|opencode-max|opencode-luna-low|opencode-luna|codex-low|codex|codex-high|codex-xhigh|codex-max|claude|claudex|claudex-high|terra|terra-high|luna-low|luna|luna-max> "Role · PersonName Goal" [working-directory]\n' >&2
}

if [ "${HERDR_ENV:-}" != "1" ]; then
    printf 'herdr-agent must be run from inside a Herdr-managed pane.\n' >&2
    exit 2
fi

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
    usage
    exit 2
fi

surface="$1"
label="$2"
launch_dir="${3:-$PWD}"
script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
launch_env=()
agent_kind=""

configure_opencode() {
    local model="$1"
    local effort="$2"
    local config
    if ! command -v opencode >/dev/null 2>&1; then
        printf 'OpenCode is unavailable.\n' >&2
        exit 2
    fi
    local auth_output
    auth_output="$(opencode auth list 2>/dev/null || true)"
    if ! grep -q 'OpenAI.*oauth' <<<"$auth_output"; then
        printf 'OpenCode has no OpenAI OAuth login. Run opencode, use /connect, and select OpenAI then ChatGPT Plus/Pro.\n' >&2
        exit 2
    fi
    if ! python3 - "${XDG_DATA_HOME:-${HOME}/.local/share}/opencode/auth.json" <<'PY'
import json
import sys
import time

try:
    auth = json.load(open(sys.argv[1], encoding="utf-8"))["openai"]
    valid = auth.get("type") == "oauth" and int(auth.get("expires", 0)) > int(time.time() * 1000) + 60_000
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
    valid = False
raise SystemExit(0 if valid else 1)
PY
    then
        printf 'OpenCode OpenAI OAuth is expired or incomplete. Run: opencode auth login -p openai\n' >&2
        exit 2
    fi
    printf -v config \
        '{"agent":{"build":{"mode":"primary","model":"%s","variant":"%s","permission":{"task":{"*":"deny"}}}}}' \
        "$model" "$effort"
    launch_env=(env "OPENCODE_CONFIG_CONTENT=$config")
    launch_argv=(opencode --agent build --model "$model")
}

if [ -z "$label" ]; then
    printf 'Provide a human task name for the Herdr tab.\n' >&2
    exit 2
fi

agent_name="$(python3 - "$label" <<'PY'
import re
import sys
import unicodedata

label = unicodedata.normalize("NFKD", sys.argv[1])
ascii_label = label.encode("ascii", "ignore").decode("ascii").lower()
name = re.sub(r"[^a-z0-9]+", "-", ascii_label).strip("-")
if not name or not name[0].isalpha():
    name = "agent-" + name
print(name[:32].rstrip("-") or "agent")
PY
)"

if [ ! -d "$launch_dir" ]; then
    printf 'Working directory does not exist: %s\n' "$launch_dir" >&2
    exit 2
fi

case "$surface" in
    opencode)
        configure_opencode openai/gpt-5.6-sol medium
        ;;
    opencode-high)
        configure_opencode openai/gpt-5.6-sol high
        ;;
    opencode-xhigh)
        configure_opencode openai/gpt-5.6-sol xhigh
        ;;
    opencode-max)
        configure_opencode openai/gpt-5.6-sol max
        ;;
    opencode-luna-low)
        configure_opencode openai/gpt-5.6-luna low
        ;;
    opencode-luna)
        configure_opencode openai/gpt-5.6-luna max
        ;;
    codex-low)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=low)
        ;;
    codex)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=medium)
        ;;
    codex-high)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=high)
        ;;
    codex-xhigh)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=xhigh)
        ;;
    codex-max)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-sol -c model_reasoning_effort=max)
        ;;
    terra)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-terra -c model_reasoning_effort=medium)
        ;;
    terra-high)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-terra -c model_reasoning_effort=high)
        ;;
    luna-low)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-luna -c model_reasoning_effort=low)
        ;;
    luna|luna-max)
        agent_kind="codex"
        launch_argv=(codex -m gpt-5.6-luna -c model_reasoning_effort=max)
        ;;
    claudex|claudex-high)
        claudex_profile="medium"
        if [ "$surface" = "claudex-high" ]; then
            claudex_profile="high"
        fi
        claudex_codex_home="${XDG_CACHE_HOME:-${HOME}/.cache}/herdr/claudex-sol-${claudex_profile}"
        mkdir -p "$claudex_codex_home"
        install -m 600 \
            "$script_dir/../assets/claudex-sol-${claudex_profile}.toml" \
            "$claudex_codex_home/config.toml"
        ln -sfn "${HOME}/.codex/models_cache.json" \
            "$claudex_codex_home/models_cache.json"
        runtime_json="$(
            CODEX_HOME="$claudex_codex_home" claudex --runtime-json
        )"
        runtime_model="$(
            python3 -c 'import json,sys; print(json.load(sys.stdin)["model"])' \
                <<<"$runtime_json"
        )"
        if [ "$runtime_model" != "gpt-5.6-sol" ]; then
            printf 'Claudex is synchronized to %s, expected gpt-5.6-sol.\n' \
                "$runtime_model" >&2
            exit 2
        fi
        launch_env=(env "CODEX_HOME=$claudex_codex_home")
        launch_argv=(claudex)
        ;;
    claude)
        claude_effort="${HERDR_CLAUDE_EFFORT:-medium}"
        case "$claude_effort" in
            low|medium|high|xhigh|max) ;;
            *)
                printf 'Unsupported Claude effort: %s\n' "$claude_effort" >&2
                exit 2
                ;;
        esac
        launch_argv=(claude --model claude-opus-5 --effort "$claude_effort")
        ;;
    *)
        usage
        exit 2
        ;;
esac

if ! command -v "${launch_argv[0]}" >/dev/null 2>&1; then
    printf 'Agent executable is unavailable: %s\n' "${launch_argv[0]}" >&2
    exit 2
fi

caller_label="$({
    herdr pane get "$HERDR_PANE_ID" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"].get("label", ""))'
})"
caller_role="${caller_label%% · *}"
target_role="${label%% · *}"

require_task_card() {
    local card="${HERDR_TASK_CARD:-}"
    local human_plan="${HERDR_HUMAN_PLAN:-$PWD/HUMAN_PLAN.md}"
    if [ -z "$card" ] || [ ! -f "$card" ]; then
        printf '%s must set HERDR_TASK_CARD to its validated frozen task card before launching %s.\n' \
            "$caller_role" "$target_role" >&2
        exit 2
    fi
    if [ ! -f "$human_plan" ]; then
        human_plan="$launch_dir/HUMAN_PLAN.md"
    fi
    if [ ! -f "$human_plan" ]; then
        local project_root
        project_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
        human_plan="$project_root/HUMAN_PLAN.md"
    fi
    if [ ! -f "$human_plan" ]; then
        local launch_root
        launch_root="$(git -C "$launch_dir" rev-parse --show-toplevel 2>/dev/null || true)"
        human_plan="$launch_root/HUMAN_PLAN.md"
    fi
    if [ ! -f "$human_plan" ]; then
        printf 'HUMAN_PLAN.md is unavailable for task-goal validation.\n' >&2
        exit 2
    fi
    python3 "$script_dir/../../restart-research-team/scripts/validate_task_card.py" \
        "$card" --human-plan "$human_plan" >/dev/null
}

require_card_model() {
    local expected="$1"
    python3 - "$HERDR_TASK_CARD" "$expected" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding="utf-8").read()
match = re.search(r"^MODEL:\s*(.+)$", text, re.MULTILINE | re.IGNORECASE)
model = match.group(1).casefold() if match else ""
expected = sys.argv[2]
valid = (
    expected == "luna-max" and "luna" in model and "max" in model
    or expected == "sol-medium" and "sol" in model and "medium" in model
)
if not valid:
    print(f"Task-card MODEL does not match required {expected} route.", file=sys.stderr)
    raise SystemExit(2)
PY
}

require_card_marker() {
    local marker="$1"
    if ! grep -Eiq "^${marker}:[[:space:]]*[^[:space:]]" "$HERDR_TASK_CARD"; then
        printf 'Task card must include %s with the concrete reason or Human choice.\n' \
            "$marker" >&2
        exit 2
    fi
}

case "$caller_role" in
    "Human Orchestrator")
        if [ "${HERDR_OPERATIONS_RESTORE:-}" != "1" ] || \
           [ "$target_role" != "Launcher" ] || \
           [ "$surface" != "codex" ]; then
            printf 'Human Orchestrator cannot launch agents; use restore-herdr-operations only when Operations is missing.\n' >&2
            exit 2
        fi
        ;;
    "Operations Collaborator")
        printf 'Operations Collaborator cannot launch productive roles.\n' >&2
        exit 2
        ;;
    "Operations Lead")
        case "$target_role" in
            Suborchestrator)
                require_task_card
                [ "$surface" = "codex" ] || {
                    printf 'Suborchestrators must use native Codex Sol medium.\n' >&2
                    exit 2
                }
                require_card_model sol-medium
                ;;
            Worker)
                require_task_card
                case "$surface" in
                    luna|luna-max)
                        require_card_model luna-max
                        ;;
                    codex)
                        require_card_model sol-medium
                        require_card_marker "LUNA FAILURE"
                        ;;
                    opencode*|claude|terra-high)
                        require_card_marker "HUMAN MODEL CHOICE"
                        ;;
                    *)
                        printf 'Worker route %s is not allowed from Operations.\n' "$surface" >&2
                        exit 2
                        ;;
                esac
                ;;
        esac
        ;;
    Suborchestrator)
        [ "$target_role" = "Worker" ] || {
            printf 'Suborchestrator may launch only its own Worker.\n' >&2
            exit 2
        }
        require_task_card
        case "$surface" in
            luna|luna-max)
                require_card_model luna-max
                ;;
            codex)
                require_card_model sol-medium
                require_card_marker "LUNA FAILURE"
                ;;
            opencode*|claude|terra-high)
                require_card_marker "HUMAN MODEL CHOICE"
                ;;
            *)
                printf 'Worker route %s is not allowed from a suborchestrator.\n' "$surface" >&2
                exit 2
                ;;
        esac
        ;;
esac

tab_json="$(
    herdr tab create \
        --workspace "$HERDR_WORKSPACE_ID" \
        --cwd "$launch_dir" \
        --label "$label" \
        --no-focus
)"

readarray -t created_ids < <(
    python3 -c '
import json
import sys
result = json.load(sys.stdin)["result"]
print(result["tab"]["tab_id"])
print(result["root_pane"]["pane_id"])
' <<<"$tab_json"
)
tab_id="${created_ids[0]}"
pane_id="${created_ids[1]}"

if [ -n "${HERDR_TASK_CARD:-}" ] && [ -f "$HERDR_TASK_CARD" ]; then
    task_state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/herdr/task-cards/${HERDR_WORKSPACE_ID}"
    mkdir -p "$task_state_dir"
    install -m 600 "$HERDR_TASK_CARD" "$task_state_dir/${pane_id}.card"
    git -C "$launch_dir" rev-parse HEAD >"$task_state_dir/${pane_id}.base" 2>/dev/null || \
        : >"$task_state_dir/${pane_id}.base"
fi

cleanup_failed_launch() {
    herdr tab close "$tab_id" >/dev/null 2>&1 || true
}
trap cleanup_failed_launch ERR

herdr pane rename "$pane_id" "$label" >/dev/null
if [ -n "$agent_kind" ]; then
    agent_started=0
    for _ in $(seq 1 100); do
        if start_output="$(
            herdr agent start "$agent_name" --kind "$agent_kind" \
                --pane "$pane_id" -- "${launch_argv[@]:1}" 2>&1
        )"; then
            agent_started=1
            break
        fi
        if ! grep -q '"code":"agent_pane_busy"' <<<"$start_output"; then
            printf '%s\n' "$start_output" >&2
            exit 1
        fi
        sleep 0.05
    done
    if [ "$agent_started" != "1" ]; then
        printf 'Agent pane did not become available after launch: %s\n' \
            "$pane_id" >&2
        exit 1
    fi
else
    printf -v launch_command '%q ' "${launch_env[@]}" "${launch_argv[@]}"
    herdr pane run "$pane_id" "${launch_command% }" >/dev/null
    agent_ready=0
    for _ in $(seq 1 100); do
        if wait_output="$(
            herdr agent wait "$pane_id" \
                --until idle --until done --timeout 30000 2>&1
        )"; then
            agent_ready=1
            break
        fi
        if ! grep -q '"code":"agent_not_found"' <<<"$wait_output"; then
            printf '%s\n' "$wait_output" >&2
            exit 1
        fi
        sleep 0.1
    done
    if [ "$agent_ready" != "1" ]; then
        printf 'Agent did not register after launch: %s\n' "$pane_id" >&2
        exit 1
    fi
fi

cost_script="$(readlink -f "$script_dir/../../../runtime/bin/herdr-costs")"
if [ -x "$cost_script" ]; then
    nohup "$cost_script" register \
        --workspace "$HERDR_WORKSPACE_ID" \
        --pane "$pane_id" \
        --parent-pane "$HERDR_PANE_ID" \
        --surface "$surface" \
        --wait-seconds 86400 </dev/null >/dev/null 2>&1 &
fi

trap - ERR
printf 'Ready: %s using %s.\n' "$label" "$surface"
